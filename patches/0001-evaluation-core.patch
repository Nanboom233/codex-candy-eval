@@ -0,0 +1,136 @@
+package codexeval
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"time"
+)
+
+const pelicanMaxCode = 256 << 10
+
+const pelicanPreamble = "不使用任何工具，也不要创建或修改文件，直接在回复中完成以下任务：\n\n"
+
+type pelicanVariant struct {
+	ID       string `json:"id"`
+	Label    string `json:"label"`
+	Prompt   string `json:"prompt"`
+	language string
+}
+
+var pelicanVariants = []pelicanVariant{
+	{ID: "original", Label: "原版", language: "html", Prompt: pelicanPreamble +
+		"创建一个 HTML，内容是 SVG 绘制一个鹈鹕骑自行车的 2D 动画，你不需要任何测试，不要使用外部资产。\n\n" +
+		"在一个 ```html 代码块中给出完整的 HTML 文件。"},
+	{ID: "all-in-one", Label: "多合一版", language: "svg", Prompt: pelicanPreamble +
+		"做一张精细的SVG图片，内容是鹈鹕骑着自行车在孙悟空开的大型飞机机翼上骑行，\n" +
+		"鹈鹕展开翅膀，上面托着秦始皇的北极熊，秦始皇骑在熊上打螺丝。鹈鹕喊出\n" +
+		"“在一个黑色的袋子里放有三种口味的糖果，每种糖果有两种不同的形状（圆形和五角星形，不同的形状靠手感可以分辨）。现已知不同口味的糖和不同形状的数量统计如下表。参赛者需要在活动前决定摸出的糖果数目，那么，最少取出多少个糖果才能保证手中同时拥有不同形状的苹果味和桃子味的糖？（同时手中有圆形苹果味匹配五角星桃子味糖果，或者有圆形桃子味匹配五角星苹果味糖果都满足要求）\n" +
+		"苹果味 桃子味 西瓜味\n" +
+		"圆形 7 9 8\n" +
+		"五角星形 7 6 4”\n\n" +
+		"的结果数值\n\n" +
+		"在一个 ```svg 代码块中给出完整的 SVG 文件。"},
+}
+
+func findPelicanVariant(id string) (pelicanVariant, bool) {
+	for _, variant := range pelicanVariants {
+		if variant.ID == id {
+			return variant, true
+		}
+	}
+	return pelicanVariant{}, false
+}
+
+type pelicanResult struct {
+	Info
+	Status          string    `json:"status"`
+	ID              string    `json:"id"`
+	Time            time.Time `json:"time"`
+	Model           string    `json:"model"`
+	Effort          string    `json:"effort"`
+	Variant         string    `json:"variant"`
+	Skipped         bool      `json:"skipped,omitempty"`
+	HTML            string    `json:"html,omitempty"`
+	Error           string    `json:"error,omitempty"`
+	InputTokens     int64     `json:"input_tokens"`
+	OutputTokens    int64     `json:"output_tokens"`
+	ReasoningTokens int64     `json:"reasoning_tokens"`
+	DurationMS      int64     `json:"duration_ms"`
+	Attempts        int       `json:"attempts,omitempty"`
+}
+
+// summary drops the HTML, which previews load per record.
+func (r pelicanResult) summary() pelicanResult {
+	r.HTML = ""
+	return r
+}
+
+var (
+	pelicanResults = map[string][]pelicanResult{}
+	pelicanRunning = map[string]bool{}
+)
+
+func runPelican(auth credential, model, effort string, variant pelicanVariant) {
+	r := evaluatePelican(auth, model, effort, variant)
+	mu.Lock()
+	defer mu.Unlock()
+	pelicanResults[auth.ID] = appendRecent(pelicanResults[auth.ID], r)
+	delete(pelicanRunning, auth.ID)
+	_ = saveStateLocked()
+}
+
+func evaluatePelican(auth credential, model, effort string, variant pelicanVariant) pelicanResult {
+	now := time.Now()
+	r := pelicanResult{Info: auth.info(), Status: "completed", ID: fmt.Sprint(now.UnixNano()), Time: now.UTC(), Model: model, Effort: effort, Variant: variant.ID}
+	var page string
+	out, attempts, err := askCodex(auth.ctx, auth, model, effort, "", variant.Prompt, answerTimeout, func(answer string) (err error) {
+		page, err = variant.page(answer)
+		return err
+	}, nil)
+	r.Attempts = attempts
+	r.DurationMS = time.Since(now).Milliseconds()
+	r.InputTokens, r.OutputTokens, r.ReasoningTokens = out.InputTokens, out.OutputTokens, out.ReasoningTokens
+	if err != nil {
+		r.Error = truncate(err.Error(), 500)
+		r.Status = failedStatus(auth.ctx)
+		return r
+	}
+	r.HTML = page
+	return r
+}
+
+func (v pelicanVariant) page(answer string) (string, error) {
+	code, language := extractCode(answer, v.language), strings.ToUpper(v.language)
+	switch {
+	case code == "":
+		return "", fmt.Errorf("回答中没有 %s 代码", language)
+	case len(code) > pelicanMaxCode:
+		return "", fmt.Errorf("%s 超过 %d KB，未保存", language, pelicanMaxCode>>10)
+	case v.language == "svg":
+		return "<!doctype html><style>html, body { height: 100%; margin: 0; } body > svg { display: block; width: 100%; height: 100%; }</style>" + code, nil
+	default:
+		return code, nil
+	}
+}
+
+var codeBlock = regexp.MustCompile("(?s)```[ \\t]*([\\w-]*)[^\\n]*\\n(.*?)\\n[ \\t]*```")
+
+// Prefer the requested language, then the first markup block or an unfenced markup answer.
+func extractCode(answer, language string) string {
+	blocks := codeBlock.FindAllStringSubmatch(answer, -1)
+	for _, block := range blocks {
+		if strings.EqualFold(block[1], language) {
+			return strings.TrimSpace(block[2])
+		}
+	}
+	for _, block := range blocks {
+		if code := strings.TrimSpace(block[2]); strings.HasPrefix(code, "<") {
+			return code
+		}
+	}
+	if text := strings.TrimSpace(answer); len(blocks) == 0 && strings.HasPrefix(text, "<") {
+		return text
+	}
+	return ""
+}
diff --git a/backend/internal/codexeval/runtime.go b/backend/internal/codexeval/runtime.go
new file mode 100644
index 0000000..c969032
--- /dev/null
+++ b/backend/internal/codexeval/runtime.go
@@ -0,0 +1,278 @@
+package codexeval
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// One evaluation instance belongs to the native server. Account credentials remain
+// inside AccountTestService; this package receives only a name and a direct sender.
+type Target struct {
+	GroupID   int64 `json:"group_id"`
+	AccountID int64 `json:"account_id"`
+}
+type Info struct {
+	Target
+	AccountName string `json:"account_name"`
+	RunID       string `json:"run_id"`
+}
+type credential struct {
+	ID     string
+	Target Target
+	Name   string
+	runID  string
+	ctx    context.Context
+}
+
+func (a credential) info() Info { return Info{a.Target, a.Name, a.runID} }
+
+type Sender func(context.Context, int64, []byte, http.Header) (*http.Response, error)
+type Resolver func(context.Context, int64) (string, error)
+
+var (
+	mu      sync.Mutex
+	sender  Sender
+	resolve Resolver
+	active  = map[string]*run{}
+)
+
+type run struct {
+	ID       string `json:"id"`
+	Type     string `json:"type"`
+	Target   Target `json:"target"`
+	Status   string `json:"status"`
+	Progress any    `json:"progress"`
+	cancel   context.CancelFunc
+}
+
+func Initialize(dataDir string, send Sender, lookup Resolver) {
+	sender, resolve = send, lookup
+	statePath = filepath.Join(dataDir, "codex-eval", "history.json")
+	if err := os.MkdirAll(filepath.Dir(statePath), 0700); err != nil {
+		storageError = err.Error()
+	}
+	loadState()
+}
+
+type StartRequest struct {
+	Type        string   `json:"type"`
+	Targets     []Target `json:"targets"`
+	Model       string   `json:"model"`
+	Effort      string   `json:"effort"`
+	Runs        int      `json:"runs"`
+	Concurrency int      `json:"concurrency"`
+	Variant     string   `json:"variant"`
+}
+type unavailable struct {
+	Target Target `json:"target"`
+	Error  string `json:"error"`
+}
+type StartSummary struct {
+	Started     []run         `json:"started"`
+	Busy        []Target      `json:"busy"`
+	Unavailable []unavailable `json:"unavailable"`
+}
+
+func Start(ctx context.Context, req StartRequest) (StartSummary, error) {
+	return start(ctx, req, false)
+}
+
+func start(ctx context.Context, req StartRequest, inspection bool) (StartSummary, error) {
+	return startChecked(ctx, req, inspection, nil)
+}
+
+func startChecked(ctx context.Context, req StartRequest, inspection bool, check func(context.Context, int64) error) (StartSummary, error) {
+	summary := StartSummary{Started: []run{}, Busy: []Target{}, Unavailable: []unavailable{}}
+	req.Model = strings.TrimSpace(req.Model)
+	req.Effort = strings.TrimSpace(req.Effort)
+	if req.Type == "siwc" && req.Model == "" {
+		req.Model = "gpt-6.1-sol"
+	}
+	if !validModelName(req.Model, req.Type == "candy" || req.Type == "pelican") {
+		return summary, fmt.Errorf("请选择有效模型")
+	}
+	if len(req.Targets) == 0 {
+		return summary, fmt.Errorf("请选择账户")
+	}
+	var variant pelicanVariant
+	switch req.Type {
+	case "candy":
+		req.Runs = min(max(req.Runs, 1), candyMaxRuns)
+	case "pelican":
+		if req.Variant == "" {
+			req.Variant = "original"
+		}
+		var ok bool
+		variant, ok = findPelicanVariant(req.Variant)
+		if !ok {
+			return summary, fmt.Errorf("请选择有效版本")
+		}
+	case "fingerprint":
+		if req.Concurrency == 0 {
+			req.Concurrency = fingerprintDefaultConcurrency
+		}
+		if req.Concurrency < 1 || req.Concurrency > fingerprintMaxConcurrency {
+			return summary, fmt.Errorf("每账户并发须为 1–%d", fingerprintMaxConcurrency)
+		}
+	case "siwc":
+	default:
+		return summary, fmt.Errorf("未知测试类型")
+	}
+	seen := map[int64]bool{}
+	for _, target := range req.Targets {
+		if seen[target.AccountID] {
+			continue
+		}
+		seen[target.AccountID] = true
+		if target.AccountID <= 0 || (!inspection && target.GroupID <= 0) {
+			summary.Unavailable = append(summary.Unavailable, unavailable{target, "账户与分组 ID 必须为正整数"})
+			continue
+		}
+		name, err := resolve(ctx, target.AccountID)
+		if err != nil {
+			summary.Unavailable = append(summary.Unavailable, unavailable{target, err.Error()})
+			continue
+		}
+		id := strconv.FormatInt(target.AccountID, 10)
+		mu.Lock()
+		if active[id] != nil {
+			summary.Busy = append(summary.Busy, target)
+			mu.Unlock()
+			continue
+		}
+		parent := context.Background()
+		if inspection {
+			parent = ctx
+		}
+		runCtx, cancel := context.WithCancel(parent)
+		a := credential{id, target, name, uuidV7().String(), runCtx}
+		r := &run{ID: a.runID, Type: req.Type, Target: target, Status: "running"}
+		r.cancel = cancel
+		active[id] = r
+		switch req.Type {
+		case "candy":
+			candyRunning[id] = &candyProgress{Total: req.Runs}
+			r.Progress = candyRunning[id]
+		case "pelican":
+			pelicanRunning[id] = true
+		case "fingerprint":
+			fingerprintRunning[id] = &fingerprintProgress{Model: req.Model, Total: fingerprintTarget, Concurrency: req.Concurrency}
+			r.Progress = fingerprintRunning[id]
+		case "siwc":
+			siwcRunning[id] = true
+		}
+		// Start replies expose identity; state serializes progress under the lock.
+		copyRun := *r
+		copyRun.Progress = nil
+		copyRun.cancel = nil
+		summary.Started = append(summary.Started, copyRun)
+		fpProgress := fingerprintRunning[id]
+		mu.Unlock()
+		go func() {
+			defer func() { cancel(); mu.Lock(); delete(active, id); mu.Unlock() }()
+			var beforeSend func() error
+			if check != nil {
+				beforeSend = func() error { return check(runCtx, target.AccountID) }
+			}
+			switch req.Type {
+			case "candy":
+				runCandyChecked(a, req.Model, req.Effort, req.Runs, beforeSend)
+			case "pelican":
+				runPelican(a, req.Model, req.Effort, variant)
+			case "fingerprint":
+				runFingerprintChecked(runCtx, a, req.Model, fpProgress, beforeSend)
+			case "siwc":
+				runSIWC(a, req.Model)
+			}
+		}()
+	}
+	return summary, nil
+}
+func Cancel(id string) bool {
+	mu.Lock()
+	defer mu.Unlock()
+	for _, r := range active {
+		if r.ID == id {
+			r.Status = "cancelling"
+			r.cancel()
+			return true
+		}
+	}
+	return false
+}
+func State() ([]byte, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	runs := make([]*run, 0, len(active))
+	for _, r := range active {
+		runs = append(runs, r)
+	}
+	fp := map[string][]fingerprintResult{}
+	pl := map[string][]pelicanResult{}
+	sw := map[string][]siwcResult{}
+	for id, rs := range fingerprintResults {
+		fp[id] = summaries(rs)
+	}
+	for id, rs := range pelicanResults {
+		pl[id] = summaries(rs)
+	}
+	for id, rs := range siwcResults {
+		sw[id] = summaries(rs)
+	}
+	raw, err := json.Marshal(map[string]any{"active": runs, "candy": candyResults, "fingerprint": fp, "pelican": pl, "siwc": sw, "storage_error": storageError})
+	return raw, err
+}
+func Record(kind string, accountID int64, id string) ([]byte, int) {
+	r := recordResponse(kind, url.Values{"auth_id": {strconv.FormatInt(accountID, 10)}, "id": {id}})
+	if r.StatusCode != 200 {
+		return r.Body, r.StatusCode
+	}
+	var record json.RawMessage = r.Body
+	raw, _ := json.Marshal(map[string]any{"type": kind, kind: record})
+	return raw, 200
+}
+func Clear(scope string) ([]byte, int) { r := clearHistoryResponse(scope); return r.Body, r.StatusCode }
+func failedStatus(ctx context.Context) string {
+	if ctx.Err() != nil {
+		return "cancelled"
+	}
+	return "failed"
+}
+func summaries[T interface{ summary() T }](rs []T) []T {
+	out := make([]T, len(rs))
+	for i, r := range rs {
+		out[i] = r.summary()
+	}
+	return out
+}
+func truncate(text string, limit int) string {
+	r := []rune(strings.TrimSpace(text))
+	if len(r) > limit {
+		return string(r[:limit]) + "…"
+	}
+	return string(r)
+}
+
+type managementResponse struct {
+	StatusCode int
+	Body       []byte
+}
+
+func jsonResponse(status int, v any) managementResponse {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return jsonError(500, err.Error())
+	}
+	return managementResponse{status, raw}
+}
+func jsonError(status int, message string) managementResponse {
+	return jsonResponse(status, map[string]any{"error": map[string]string{"message": message}})
+}
diff --git a/backend/internal/codexeval/siwc.go b/backend/internal/codexeval/siwc.go
new file mode 100644
index 0000000..db211d8
--- /dev/null
+++ b/backend/internal/codexeval/siwc.go
@@ -0,0 +1,134 @@
+package codexeval
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+)
+
+const siwcTimeout = time.Minute
+
+type siwcResult struct {
+	Info
+	ID              string    `json:"id"`
+	Time            time.Time `json:"time"`
+	Model           string    `json:"model"`
+	Status          string    `json:"status"`
+	Code            string    `json:"code,omitempty"`
+	HTTPStatus      int       `json:"http_status,omitempty"`
+	Error           string    `json:"error,omitempty"`
+	DurationMS      int64     `json:"duration_ms"`
+	InputTokens     int64     `json:"input_tokens"`
+	OutputTokens    int64     `json:"output_tokens"`
+	ReasoningTokens int64     `json:"reasoning_tokens"`
+}
+
+func (r siwcResult) summary() siwcResult {
+	return r
+}
+
+var (
+	siwcResults = map[string][]siwcResult{}
+	siwcRunning = map[string]bool{}
+)
+
+func runSIWC(auth credential, model string) {
+	r := evaluateSIWC(auth, model)
+	mu.Lock()
+	defer mu.Unlock()
+	siwcResults[auth.ID] = appendRecent(siwcResults[auth.ID], r)
+	delete(siwcRunning, auth.ID)
+	_ = saveStateLocked()
+}
+
+func evaluateSIWC(auth credential, model string) (r siwcResult) {
+	now := time.Now()
+	r = siwcResult{
+		Info:   auth.info(),
+		ID:     fmt.Sprint(now.UnixNano()),
+		Time:   now.UTC(),
+		Model:  model,
+		Status: "failed",
+	}
+	body := map[string]any{
+		"model": model, "store": false, "stream": true,
+		"input": []map[string]string{{"role": "user", "content": "Reply with OK."}},
+	}
+	headers := http.Header{
+		"Content-Type": {"application/json"},
+		"Accept":       {"text/event-stream"},
+		"User-Agent":   {"cpa-siwc-check/" + pluginVersion},
+	}
+	requestCtx, cancel := withModelTimeout(auth.ctx, siwcTimeout)
+	out, status, err := executeResponse(requestCtx, auth, model, body, headers)
+	cancel()
+	r.DurationMS = time.Since(now).Milliseconds()
+	r.InputTokens = out.Usage.InputTokens
+	r.OutputTokens = out.Usage.OutputTokens
+	r.ReasoningTokens = out.Usage.OutputTokensDetails.ReasoningTokens
+	if auth.ctx.Err() != nil {
+		r.Status = "cancelled"
+		r.Error = "检测已取消"
+		return
+	}
+	if err == nil && out.completed() {
+		r.Status = "available"
+		return
+	}
+	if status != http.StatusOK && status > 0 {
+		r.HTTPStatus = status
+	}
+	message := "模型响应未完成"
+	if err != nil {
+		message = err.Error()
+	} else if len(out.Error) > 0 && string(out.Error) != "null" {
+		message = string(out.Error)
+	}
+	r.Code, r.Error = siwcErrorDetails(message)
+	switch {
+	case r.Code == "subscription_sharing_user_not_eligible":
+		r.Status = "restricted"
+	case r.Code == "subscription_sharing_usage_limit_exceeded":
+		r.Status = "limited"
+	case r.Code == "subscription_sharing_invalid_user" || r.HTTPStatus == http.StatusUnauthorized:
+		r.Status = "auth_error"
+	case r.HTTPStatus == http.StatusTooManyRequests:
+		r.Status = "limited"
+	}
+	if r.Error == "" {
+		r.Error = truncate(message, 500)
+	}
+	return
+}
+
+func siwcErrorDetails(message string) (code, text string) {
+	start := strings.IndexByte(message, '{')
+	if start < 0 {
+		return "", truncate(message, 500)
+	}
+	var parsed struct {
+		Error struct {
+			Code    string `json:"code"`
+			Message string `json:"message"`
+		} `json:"error"`
+		Code    string `json:"code"`
+		Message string `json:"message"`
+	}
+	if json.Unmarshal([]byte(message[start:]), &parsed) != nil {
+		return "", truncate(message, 500)
+	}
+	code = truncate(firstText(parsed.Error.Code, parsed.Code), 120)
+	text = truncate(firstText(parsed.Error.Message, parsed.Message, message), 500)
+	return
+}
+
+func firstText(values ...string) string {
+	for _, value := range values {
+		if value = strings.TrimSpace(value); value != "" {
+			return value
+		}
+	}
+	return ""
+}
diff --git a/backend/internal/codexeval/state.go b/backend/internal/codexeval/state.go
new file mode 100644
index 0000000..31a3a08
--- /dev/null
+++ b/backend/internal/codexeval/state.go
@@ -0,0 +1,213 @@
+package codexeval
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"slices"
+)
+
+const historySchemaVersion = 3
+
+type persistedState struct {
+	SchemaVersion int                            `json:"schema_version"`
+	Results       map[string][]candyResult       `json:"results"`
+	Fingerprints  map[string][]fingerprintResult `json:"fingerprints"`
+	Pelicans      map[string][]pelicanResult     `json:"pelicans,omitempty"`
+	SIWC          map[string][]siwcResult        `json:"siwc,omitempty"`
+}
+
+var (
+	statePath      string
+	loaded         bool
+	stateLoadError error
+	storageError   string
+)
+
+func loadState() {
+	mu.Lock()
+	defer mu.Unlock()
+	if loaded {
+		return
+	}
+	loaded = true
+	data, err := os.ReadFile(statePath)
+	if errors.Is(err, os.ErrNotExist) {
+		return
+	}
+	var state *struct {
+		SchemaVersion json.RawMessage            `json:"schema_version"`
+		Results       map[string][]candyResult   `json:"results"`
+		Fingerprints  json.RawMessage            `json:"fingerprints"`
+		Pelicans      map[string][]pelicanResult `json:"pelicans"`
+		SIWC          map[string][]siwcResult    `json:"siwc"`
+	}
+	var fingerprints map[string][]fingerprintResult
+	version := 0
+	if err == nil {
+		err = json.Unmarshal(data, &state)
+		if err == nil && state == nil {
+			err = errors.New("测试记录格式无效")
+		}
+		if err == nil && len(state.SchemaVersion) > 0 {
+			var marker *int
+			err = json.Unmarshal(state.SchemaVersion, &marker)
+			if err == nil && (marker == nil || *marker < 1 || *marker > historySchemaVersion) {
+				err = errors.New("测试记录格式无效")
+			}
+			if err == nil {
+				version = *marker
+			}
+			if err == nil && len(state.Fingerprints) > 0 {
+				err = json.Unmarshal(state.Fingerprints, &fingerprints)
+			}
+		}
+	}
+	if err != nil {
+		stateLoadError = fmt.Errorf("测试记录读取失败，为保护原文件已暂停保存：%w", err)
+		storageError = stateLoadError.Error()
+		return
+	}
+	if state.Results != nil {
+		candyResults = state.Results
+	}
+	if fingerprints != nil {
+		fingerprintResults = fingerprints
+	}
+	if state.Pelicans != nil {
+		pelicanResults = state.Pelicans
+	}
+	if state.SIWC != nil {
+		siwcResults = state.SIWC
+	}
+	keepRecent(candyResults)
+	keepRecent(fingerprintResults)
+	keepRecent(pelicanResults)
+	keepRecent(siwcResults)
+	if version < historySchemaVersion {
+		if version < 2 {
+			for id, records := range pelicanResults {
+				for i := range records {
+					records[i].Variant = "original"
+				}
+				pelicanResults[id] = records
+			}
+		}
+		backup := filepath.Join(filepath.Dir(statePath), fmt.Sprintf("history.v%d.json", version))
+		copy, err := os.OpenFile(backup, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0600)
+		if err == nil {
+			err = copy.Chmod(0600)
+			if err == nil {
+				_, err = copy.Write(data)
+			}
+			if closeErr := copy.Close(); err == nil {
+				err = closeErr
+			}
+		}
+		if err != nil {
+			stateLoadError = fmt.Errorf("测试记录备份失败，已暂停保存：%w", err)
+			storageError = stateLoadError.Error()
+			return
+		}
+		_ = saveStateLocked()
+	}
+}
+
+// Each credential keeps its latest historyLimit records of every test.
+const historyLimit = 20
+
+func appendRecent[T any](history []T, r T) []T {
+	history = append(history, r)
+	return history[max(0, len(history)-historyLimit):]
+}
+
+func keepRecent[T any](histories map[string][]T) {
+	for id, history := range histories {
+		histories[id] = history[max(0, len(history)-historyLimit):]
+	}
+}
+
+func currentState() persistedState {
+	return persistedState{SchemaVersion: historySchemaVersion, Results: candyResults, Fingerprints: fingerprintResults, Pelicans: pelicanResults, SIWC: siwcResults}
+}
+
+// Call with mu held so all histories are written as one snapshot.
+func saveStateLocked() (err error) {
+	defer func() {
+		storageError = ""
+		if err != nil {
+			storageError = "测试记录保存失败：" + err.Error()
+		}
+	}()
+	if stateLoadError != nil {
+		return stateLoadError
+	}
+	data, err := json.Marshal(currentState())
+	if err != nil {
+		return err
+	}
+	tmp := statePath + ".tmp"
+	defer os.Remove(tmp)
+	if err = os.WriteFile(tmp, data, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, statePath)
+}
+
+func recordResponse(scope string, query url.Values) managementResponse {
+	authID, id := query.Get("auth_id"), query.Get("id")
+	mu.Lock()
+	defer mu.Unlock()
+	var record any
+	switch scope {
+	case "fingerprint":
+		if i := slices.IndexFunc(fingerprintResults[authID], func(r fingerprintResult) bool { return r.ID == id }); i >= 0 {
+			record = fingerprintResults[authID][i]
+		}
+	case "pelican":
+		if i := slices.IndexFunc(pelicanResults[authID], func(r pelicanResult) bool { return r.ID == id }); i >= 0 {
+			record = pelicanResults[authID][i]
+		}
+	case "siwc":
+		if i := slices.IndexFunc(siwcResults[authID], func(r siwcResult) bool { return r.ID == id || r.RunID == id }); i >= 0 {
+			record = siwcResults[authID][i]
+		}
+	}
+	if record == nil {
+		return jsonError(http.StatusNotFound, "记录不存在，可能已被清空")
+	}
+	return jsonResponse(http.StatusOK, record)
+}
+
+func clearHistoryResponse(scope string) managementResponse {
+	mu.Lock()
+	defer mu.Unlock()
+	previous := currentState()
+	switch scope {
+	case "fingerprint":
+		fingerprintResults = map[string][]fingerprintResult{}
+	case "candy":
+		candyResults = map[string][]candyResult{}
+	case "pelican":
+		pelicanResults = map[string][]pelicanResult{}
+	case "siwc":
+		siwcResults = map[string][]siwcResult{}
+	case "all":
+		candyResults, fingerprintResults = map[string][]candyResult{}, map[string][]fingerprintResult{}
+		pelicanResults = map[string][]pelicanResult{}
+		siwcResults = map[string][]siwcResult{}
+	default:
+		return jsonError(http.StatusBadRequest, "未知测试类型")
+	}
+	if err := saveStateLocked(); err != nil {
+		candyResults, fingerprintResults = previous.Results, previous.Fingerprints
+		pelicanResults = previous.Pelicans
+		siwcResults = previous.SIWC
+		return jsonError(http.StatusInternalServerError, "清空测试记录失败："+err.Error())
+	}
+	return jsonResponse(http.StatusOK, map[string]bool{"cleared": true})
+}
