new file mode 100644
index 0000000..7df9022
--- /dev/null
+++ b/backend/internal/codexeval/candy.go
@@ -0,0 +1,113 @@
+package codexeval
+
+import (
+	"errors"
+	"time"
+)
+
+const candyMaxRuns = 10
+
+var (
+	candyResults = map[string][]candyResult{}
+	candyRunning = map[string]*candyProgress{}
+)
+
+const candyPrompt = `不使用任何外部工具回答以下问题：
+
+在一个黑色的袋子里放有三种口味的糖果，每种糖果有两种不同的形状（圆形和五角星形，不同的形状靠手感可以分辨）。现已知不同口味的糖和不同形状的数量统计如下表。参赛者需要在活动前决定摸出的糖果数目，那么，最少取出多少个糖果才能保证手中同时拥有不同形状的苹果味和桃子味的糖？（同时手中有圆形苹果味匹配五角星桃子味糖果，或者有圆形桃子味匹配五角星苹果味糖果都满足要求）
+
+        苹果味  桃子味  西瓜味
+圆形       7      9      8
+五角星形   7      6      4
+`
+
+type candyResult struct {
+	Info
+	Status          string    `json:"status"`
+	Skipped         bool      `json:"skipped,omitempty"`
+	Time            time.Time `json:"time"`
+	Model           string    `json:"model"`
+	Effort          string    `json:"effort"`
+	OK              bool      `json:"ok"`
+	Answer          string    `json:"answer,omitempty"`
+	Error           string    `json:"error,omitempty"`
+	InputTokens     int64     `json:"input_tokens"`
+	OutputTokens    int64     `json:"output_tokens"`
+	ReasoningTokens int64     `json:"reasoning_tokens"`
+	DurationMS      int64     `json:"duration_ms"`
+	Attempts        int       `json:"attempts,omitempty"`
+}
+
+type candyProgress struct {
+	Done  int `json:"done"`
+	Total int `json:"total"`
+}
+
+// Each credential runs serially; different credentials run in parallel.
+func runCandy(auth credential, model, effort string, runs int) {
+	runCandyChecked(auth, model, effort, runs, nil)
+}
+
+func runCandyChecked(auth credential, model, effort string, runs int, check func() error) {
+	id := auth.ID
+	defer func() {
+		mu.Lock()
+		delete(candyRunning, id)
+		mu.Unlock()
+	}()
+	for range runs {
+		mu.Lock()
+		stopping := auth.ctx.Err() != nil
+		mu.Unlock()
+		if stopping {
+			return
+		}
+		r, save := evaluateCandyChecked(auth, model, effort, check)
+		if !save {
+			return
+		}
+		mu.Lock()
+		candyResults[id] = appendRecent(candyResults[id], r)
+		candyRunning[id].Done++
+		_ = saveStateLocked()
+		mu.Unlock()
+	}
+}
+
+func evaluateCandy(auth credential, model, effort string) candyResult {
+	r, _ := evaluateCandyChecked(auth, model, effort, nil)
+	return r
+}
+
+var errInspectionStopped = errors.New("inspection disabled")
+
+func evaluateCandyChecked(auth credential, model, effort string, check func() error) (candyResult, bool) {
+	r := candyResult{Info: auth.info(), Status: "completed", Time: time.Now().UTC(), Model: model, Effort: effort}
+	started := time.Now()
+	out, attempts, err := askCodex(auth.ctx, auth, model, effort, "", candyPrompt, answerTimeout, nil, check)
+	if errors.Is(err, errInspectionStopped) {
+		return r, false
+	}
+	r.Attempts = attempts
+	r.DurationMS = time.Since(started).Milliseconds()
+	r.InputTokens, r.OutputTokens, r.ReasoningTokens = out.InputTokens, out.OutputTokens, out.ReasoningTokens
+	if err != nil {
+		r.Error = truncate(err.Error(), 500)
+		r.Status = failedStatus(auth.ctx)
+		return r, true
+	}
+	r.Answer = truncate(out.Answer, 4000)
+	r.OK = hasStandalone21(out.Answer)
+	return r, true
+}
+
+// hasStandalone21 reports whether "21" appears without adjacent digits.
+func hasStandalone21(text string) bool {
+	isDigit := func(i int) bool { return i >= 0 && i < len(text) && text[i] >= '0' && text[i] <= '9' }
+	for i := 0; i+1 < len(text); i++ {
+		if text[i] == '2' && text[i+1] == '1' && !isDigit(i-1) && !isDigit(i+2) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/backend/internal/codexeval/codex.go b/backend/internal/codexeval/codex.go
new file mode 100644
index 0000000..e335ce8
--- /dev/null
+++ b/backend/internal/codexeval/codex.go
@@ -0,0 +1,243 @@
+package codexeval
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha1"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"time"
+)
+
+// A Codex turn is the first request of a new codex-tui 0.163.0 thread on Responses Lite.
+// data/codex_context.json holds that client's tools, base instructions and turn context, taken
+// from a request captured on Linux with the machine's paths replaced by /home/user/workspace.
+const (
+	codexUserAgent   = "codex-tui/0.163.0 (Debian 13.0.0; x86_64) xterm-ghostty (codex-tui; 0.163.0)"
+	codexEnvironment = `<environment_context>
+  <cwd>/home/user/workspace</cwd>
+  <shell>bash</shell>
+  <current_date>%s</current_date>
+  <timezone>Etc/UTC</timezone>
+  <filesystem><workspace_roots><root>/home/user/workspace</root></workspace_roots><permission_profile type="managed"><file_system type="restricted"><entry access="read"><special>:root</special></entry><entry access="write"><path>/home/user/workspace</path></entry><entry access="write"><special>:slash_tmp</special></entry><entry access="write"><special>:tmpdir</special></entry><entry access="read"><path>/home/user/workspace/.git</path></entry><entry access="read"><path>/home/user/workspace/.agents</path></entry><entry access="read"><path>/home/user/workspace/.codex</path></entry><entry access="read"><path>/home/user/workspace/.aws</path></entry></file_system></permission_profile></filesystem>
+</environment_context>`
+)
+
+// codexText is one text part of a context message, labeled with the kind Codex reports for it.
+type codexText struct {
+	Kind string `json:"kind"`
+	Text string `json:"text"`
+}
+
+//go:embed data/codex_context.json
+var codexContextJSON []byte
+
+var codexContext = mustDecode[struct {
+	Tools            json.RawMessage `json:"tools"`
+	BaseInstructions string          `json:"base_instructions"`
+	Messages         []struct {
+		Role    string      `json:"role"`
+		Content []codexText `json:"content"`
+	} `json:"messages"`
+}](codexContextJSON)
+
+// codexTools is the tools list as Codex sends it; the tools item ID hashes these exact bytes.
+var codexTools = func() []byte {
+	var tools bytes.Buffer
+	if err := json.Compact(&tools, codexContext.Tools); err != nil {
+		panic(err)
+	}
+	return tools.Bytes()
+}()
+
+type codexItem struct {
+	Type     string             `json:"type"`
+	ID       string             `json:"id"`
+	Role     string             `json:"role"`
+	Tools    json.RawMessage    `json:"tools,omitempty"`
+	Content  []codexContent     `json:"content,omitempty"`
+	Metadata *codexItemMetadata `json:"internal_chat_message_metadata_passthrough,omitempty"`
+}
+
+type codexContent struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+type codexItemMetadata struct {
+	TurnID           string   `json:"turn_id,omitempty"`
+	CreateTime       float64  `json:"create_time,omitempty"`
+	ContentItemKinds []string `json:"content_item_kinds"`
+}
+
+type codexReasoning struct {
+	Effort  string `json:"effort,omitempty"`
+	Context string `json:"context"`
+}
+
+type codexClientMetadata struct {
+	ThreadID       string `json:"thread_id"`
+	WindowID       string `json:"x-codex-window-id"`
+	TurnID         string `json:"turn_id"`
+	RootTurnID     string `json:"root_turn_id"`
+	TurnMetadata   string `json:"x-codex-turn-metadata"`
+	InstallationID string `json:"x-codex-installation-id"`
+	SessionID      string `json:"session_id"`
+}
+
+type codexRequest struct {
+	Model             string              `json:"model"`
+	Stream            bool                `json:"stream"`
+	Input             []codexItem         `json:"input"`
+	ToolChoice        string              `json:"tool_choice"`
+	ParallelToolCalls bool                `json:"parallel_tool_calls"`
+	Reasoning         codexReasoning      `json:"reasoning"`
+	Store             bool                `json:"store"`
+	Include           []string            `json:"include"`
+	PromptCacheKey    string              `json:"prompt_cache_key"`
+	Text              map[string]string   `json:"text"`
+	ClientMetadata    codexClientMetadata `json:"client_metadata"`
+}
+
+type codexTurnMetadata struct {
+	InstallationID             string `json:"installation_id"`
+	SessionID                  string `json:"session_id"`
+	ThreadID                   string `json:"thread_id"`
+	AgentName                  string `json:"agent_name"`
+	TurnID                     string `json:"turn_id"`
+	WindowID                   string `json:"window_id"`
+	WindowNumber               int    `json:"window_number"`
+	ContextWindowID            string `json:"context_window_id"`
+	RequestKind                string `json:"request_kind"`
+	HistoryInitialization      string `json:"history_initialization"`
+	RootTurnID                 string `json:"root_turn_id"`
+	ThreadSource               string `json:"thread_source"`
+	TurnTrigger                string `json:"turn_trigger"`
+	Sandbox                    string `json:"sandbox"`
+	SandboxMode                string `json:"sandbox_mode"`
+	AutoReviewEnabled          bool   `json:"auto_review_enabled"`
+	NodeReplAutoReviewRequired bool   `json:"node_repl_auto_review_required"`
+	NodeReplDisabled           bool   `json:"node_repl_disabled"`
+	TurnStartedAtUnixMS        int64  `json:"turn_started_at_unix_ms"`
+	AnalyticsEnabled           bool   `json:"analytics_enabled"`
+	Model                      string `json:"model"`
+	ReasoningEffort            string `json:"reasoning_effort,omitempty"`
+}
+
+// codexTurn returns the request and headers of a new Codex thread whose first user message is prompt.
+// An empty effort leaves the reasoning effort unspecified. Non-empty instructions
+// are sent as Codex sends its developer_instructions setting: first in the first context message.
+func codexTurn(authID, model, effort, instructions, prompt string) (codexRequest, http.Header) {
+	now := time.Now()
+	thread, turnID := uuidV7(), uuidV7().String()
+	threadID := thread.String()
+	windowID := threadID + ":0"
+	// Each credential acts as its own Codex installation, stable across restarts.
+	installation := sha256.Sum256([]byte("codex-installation:" + authID))
+	installationID := newUUID(installation[:], 4).String()
+	metadata, _ := json.Marshal(codexTurnMetadata{
+		InstallationID: installationID, SessionID: threadID, ThreadID: threadID, AgentName: "/root",
+		TurnID: turnID, WindowID: windowID, ContextWindowID: uuidV7().String(), RequestKind: "turn",
+		HistoryInitialization: "new", RootTurnID: turnID, ThreadSource: "user", TurnTrigger: "user",
+		Sandbox: "seccomp", SandboxMode: "workspace-write", AutoReviewEnabled: true, NodeReplAutoReviewRequired: true,
+		TurnStartedAtUnixMS: now.UnixMilli(), AnalyticsEnabled: true, Model: model, ReasoningEffort: effort,
+	})
+	created := float64(now.UnixMicro()) / 1e6
+	input := codexPrefix(thread)
+	for i, message := range codexContext.Messages {
+		parts := message.Content
+		if i == 0 && instructions != "" {
+			parts = append([]codexText{{"generic.developer_instructions", instructions}}, parts...)
+		}
+		input = append(input, codexMessage("msg_"+uuidV7().String(), message.Role, turnID, created, parts...))
+	}
+	input = append(input,
+		codexMessage("msg_"+uuidV7().String(), "user", turnID, created,
+			codexText{"environments.environment_context", fmt.Sprintf(codexEnvironment, now.UTC().Format(time.DateOnly))}),
+		codexMessage("msg_"+uuidV7().String(), "user", turnID, created, codexText{"user.text", prompt}),
+	)
+	request := codexRequest{
+		Model: model, Input: input, ToolChoice: "auto", Reasoning: codexReasoning{effort, "all_turns"},
+		Stream: true, Include: []string{"reasoning.encrypted_content"}, PromptCacheKey: threadID,
+		Text: map[string]string{"verbosity": "low"},
+		ClientMetadata: codexClientMetadata{
+			ThreadID: threadID, WindowID: windowID, TurnID: turnID, RootTurnID: turnID,
+			TurnMetadata: string(metadata), InstallationID: installationID, SessionID: threadID,
+		},
+	}
+	headers := http.Header{
+		"Accept":                                 {"text/event-stream"},
+		"Content-Type":                           {"application/json"},
+		"Originator":                             {"codex-tui"},
+		"User-Agent":                             {codexUserAgent},
+		"Session-Id":                             {threadID},
+		"Thread-Id":                              {threadID},
+		"X-Client-Request-Id":                    {threadID},
+		"X-Codex-Window-Id":                      {windowID},
+		"X-Codex-Turn-Metadata":                  {string(metadata)},
+		"X-Codex-Beta-Features":                  {"remote_compaction_v2"},
+		"X-Openai-Internal-Codex-Responses-Lite": {"true"},
+	}
+	return request, headers
+}
+
+// codexPrefix builds the tools and base instructions items Codex puts first in every request, with
+// IDs hashed from the thread ID and their content.
+func codexPrefix(thread uuid) []codexItem {
+	space := uuidV5(uuidOID, []byte(thread.String()))
+	instructions := codexContext.BaseInstructions
+	return []codexItem{
+		{Type: "additional_tools", ID: "at_" + uuidV5(space, codexTools).String(), Role: "developer", Tools: codexTools},
+		codexMessage("msg_"+uuidV5(space, []byte(instructions)).String(), "developer", "", 0, codexText{"model.base_instructions", instructions}),
+	}
+}
+
+func codexMessage(id, role, turnID string, created float64, parts ...codexText) codexItem {
+	metadata := &codexItemMetadata{TurnID: turnID, CreateTime: created}
+	item := codexItem{Type: "message", ID: id, Role: role, Metadata: metadata}
+	for _, part := range parts {
+		item.Content = append(item.Content, codexContent{"input_text", part.Text})
+		metadata.ContentItemKinds = append(metadata.ContentItemKinds, part.Kind)
+	}
+	return item
+}
+
+type uuid [16]byte
+
+// uuidOID is the RFC 9562 name space for ISO OIDs.
+var uuidOID = uuid{0x6b, 0xa7, 0xb8, 0x12, 0x9d, 0xad, 0x11, 0xd1, 0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8}
+
+func newUUID(b []byte, version byte) (id uuid) {
+	copy(id[:], b)
+	id[6] = id[6]&0x0f | version<<4
+	id[8] = id[8]&0x3f | 0x80
+	return id
+}
+
+func uuidV5(space uuid, name []byte) uuid {
+	sum := sha1.Sum(append(space[:], name...))
+	return newUUID(sum[:], 5)
+}
+
+func uuidV7() uuid {
+	var b [16]byte
+	binary.BigEndian.PutUint64(b[:], uint64(time.Now().UnixMilli())<<16)
+	_, _ = rand.Read(b[6:])
+	return newUUID(b[:], 7)
+}
+
+func (id uuid) String() string {
+	return fmt.Sprintf("%x-%x-%x-%x-%x", id[:4], id[4:6], id[6:8], id[8:10], id[10:])
+}
+
+func mustDecode[T any](data []byte) T {
+	var value T
+	if err := json.Unmarshal(data, &value); err != nil {
+		panic(err)
+	}
+	return value
+}
diff --git a/backend/internal/codexeval/fingerprint.go b/backend/internal/codexeval/fingerprint.go
new file mode 100644
index 0000000..640f9d3
--- /dev/null
+++ b/backend/internal/codexeval/fingerprint.go
@@ -0,0 +1,272 @@
+package codexeval
+
+import (
+	"context"
+	_ "embed"
+	"errors"
+	"fmt"
+	"math/rand"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Each run sends fingerprintTarget challenges, at most that many at once per credential and
+// fingerprintGlobalConcurrency across credentials. A challenge holds its slot through its retries.
+const (
+	fingerprintTarget             = 3
+	fingerprintGlobalConcurrency  = 6
+	fingerprintMaxText            = 64000
+	fingerprintDefaultConcurrency = fingerprintTarget
+	fingerprintMaxConcurrency     = fingerprintTarget
+)
+
+type fingerprintChallenge struct {
+	Instructions  string `json:"instructions,omitempty"`
+	Prompt        string `json:"prompt"`
+	ExpectedCount int    `json:"expected_count"`
+}
+
+//go:embed data/lm-detector/enrollment-suite.json
+var fingerprintSuiteJSON []byte
+
+// fingerprintSuite holds the challenges the reference answers were collected with: 12 prompt environments that
+// add a system prompt, a user prefix or nothing to their three challenges.
+var fingerprintSuite = func() []fingerprintChallenge {
+	var suite []fingerprintChallenge
+	for _, c := range mustDecode[[]struct {
+		System        string `json:"system"`
+		UserPrefix    string `json:"user_prefix"`
+		Prompt        string `json:"prompt"`
+		ExpectedCount int    `json:"expected_count"`
+	}](fingerprintSuiteJSON) {
+		prompt := c.Prompt
+		if c.UserPrefix != "" {
+			prompt = c.UserPrefix + "\n\nFinal task:\n" + c.Prompt
+		}
+		suite = append(suite, fingerprintChallenge{c.System, prompt, c.ExpectedCount})
+	}
+	return suite
+}()
+
+func fingerprintChallenges() []fingerprintChallenge {
+	challenges := make([]fingerprintChallenge, fingerprintTarget)
+	for i, j := range rand.Perm(len(fingerprintSuite))[:fingerprintTarget] {
+		challenges[i] = fingerprintSuite[j]
+	}
+	return challenges
+}
+
+// fingerprintAliases maps tested models to the candidate that stands for them: the bank enrolls gpt-6.1-sol
+// answers under gpt-6-astra, and deepseek-flash serves the model enrolled as deepseek-v4.1-flash-1017.
+// The page compares models with the same table.
+var fingerprintAliases = map[string]string{"gpt-6.1-sol": "gpt-6-astra", "deepseek-flash": "deepseek-v4.1-flash-1017"}
+
+// FingerprintModelID is the candidate a model name stands for, without a provider prefix such as "openai/".
+func FingerprintModelID(model string) string {
+	model = strings.ToLower(strings.TrimSpace(model))
+	model = model[strings.LastIndex(model, "/")+1:]
+	if alias, ok := fingerprintAliases[model]; ok {
+		return alias
+	}
+	return model
+}
+
+func fingerprintModelID(model string) string {
+	return FingerprintModelID(model)
+}
+
+type fingerprintSample struct {
+	fingerprintChallenge
+	Attempts int    `json:"attempts,omitempty"`
+	Text     string `json:"text,omitempty"`
+	Error    string `json:"error,omitempty"`
+	Parsed   int    `json:"parsed_numbers"`
+	Valid    bool   `json:"accepted"`
+}
+
+// fingerprintResult stores one completed, partial, failed, or cancelled challenge run.
+type fingerprintResult struct {
+	Info
+	ID               string                  `json:"id"`
+	Time             time.Time               `json:"time"`
+	Model            string                  `json:"model"`
+	Status           string                  `json:"status"`
+	Error            string                  `json:"error,omitempty"`
+	DurationMS       int64                   `json:"duration_ms"`
+	InputTokens      int64                   `json:"input_tokens"`
+	OutputTokens     int64                   `json:"output_tokens"`
+	ReasoningTokens  int64                   `json:"reasoning_tokens"`
+	DetectorRevision string                  `json:"detector_revision"`
+	Concurrency      int                     `json:"concurrency,omitempty"`
+	Samples          []fingerprintSample     `json:"samples"`
+	Attribution      *fingerprintAttribution `json:"attribution,omitempty"`
+}
+
+// summary drops the samples and rankings that only the detail dialog shows.
+func (r fingerprintResult) summary() fingerprintResult {
+	r.Samples = nil
+	if r.Attribution != nil {
+		attribution := *r.Attribution
+		attribution.Results, attribution.Diagnostics = nil, nil
+		r.Attribution = &attribution
+	}
+	return r
+}
+
+type fingerprintProgress struct {
+	Model       string `json:"model"`
+	Done        int    `json:"done"`
+	Total       int    `json:"total"`
+	Concurrency int    `json:"concurrency"`
+}
+
+var (
+	fingerprintSlots   = make(chan struct{}, fingerprintGlobalConcurrency)
+	fingerprintResults = map[string][]fingerprintResult{}
+	fingerprintRunning = map[string]*fingerprintProgress{}
+)
+
+func runFingerprint(ctx context.Context, auth credential, model string, p *fingerprintProgress) {
+	runFingerprintChecked(ctx, auth, model, p, nil)
+}
+
+func runFingerprintChecked(ctx context.Context, auth credential, model string, p *fingerprintProgress, check func() error) {
+	started := time.Now()
+	done := 0
+	stopped := false
+	r := fingerprintResult{Info: auth.info(), ID: fmt.Sprint(started.UnixNano()), Time: started.UTC(), Model: model, DetectorRevision: detectorRevision, Concurrency: p.Concurrency}
+	r.Status = "completed"
+	defer func() {
+		if ctx.Err() != nil && done < fingerprintTarget {
+			r.Status = "cancelled"
+		}
+		if recovered := recover(); recovered != nil {
+			r.Status, r.Error = "failed", fmt.Sprint(recovered)
+		}
+		r.DurationMS = time.Since(started).Milliseconds()
+		mu.Lock()
+		defer mu.Unlock()
+		delete(fingerprintRunning, auth.ID)
+		if stopped {
+			return
+		}
+		fingerprintResults[auth.ID] = appendRecent(fingerprintResults[auth.ID], r)
+		_ = saveStateLocked()
+	}()
+	challenges := fingerprintChallenges()
+	type event struct {
+		index  int
+		sample fingerprintSample
+		output modelResponse
+		err    error
+	}
+	jobs, events := make(chan int, fingerprintTarget), make(chan event, fingerprintTarget)
+	for i := range challenges {
+		jobs <- i
+	}
+	close(jobs)
+	var workers sync.WaitGroup
+	for range p.Concurrency {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for i := range jobs {
+				select {
+				case fingerprintSlots <- struct{}{}:
+				case <-ctx.Done():
+					return
+				}
+				sample, output, err := collectFingerprintSample(ctx, auth, model, challenges[i], check)
+				<-fingerprintSlots
+				if errors.Is(err, errInspectionStopped) {
+					events <- event{i, sample, output, err}
+					return
+				}
+				if sample.Attempts > 0 {
+					events <- event{i, sample, output, err}
+				}
+			}
+		}()
+	}
+	go func() { workers.Wait(); close(events) }()
+	samples := make([]*fingerprintSample, fingerprintTarget)
+	for e := range events {
+		if errors.Is(e.err, errInspectionStopped) {
+			stopped = true
+			continue
+		}
+		samples[e.index] = &e.sample
+		r.InputTokens += e.output.InputTokens
+		r.OutputTokens += e.output.OutputTokens
+		r.ReasoningTokens += e.output.ReasoningTokens
+		if !errors.Is(e.err, context.Canceled) {
+			done++
+		}
+		mu.Lock()
+		p.Done = done
+		mu.Unlock()
+	}
+	if stopped {
+		return
+	}
+	var outputs []fingerprintOutput
+	// Preserve challenge order even when requests complete out of order.
+	for _, sample := range samples {
+		if sample == nil {
+			continue
+		}
+		r.Samples = append(r.Samples, *sample)
+		outputs = append(outputs, fingerprintOutput{sample.Text, sample.ExpectedCount})
+	}
+	attr, err := analyzeFingerprint(outputs)
+	switch {
+	case err == nil:
+		r.Attribution = &attr
+		if attr.Used < fingerprintTarget {
+			r.Status = "partial"
+		}
+	case len(r.Samples) > 0 && r.Samples[len(r.Samples)-1].Error != "":
+		// No answer was valid; the last request's error tells why.
+		r.Status, r.Error = "failed", r.Samples[len(r.Samples)-1].Error
+	default:
+		r.Status, r.Error = "failed", err.Error()
+	}
+}
+
+// collectFingerprintSample asks challenge until an answer can be scored. The sample keeps the last answer.
+func collectFingerprintSample(ctx context.Context, auth credential, model string, challenge fingerprintChallenge, check func() error) (sample fingerprintSample, out modelResponse, err error) {
+	sample.fingerprintChallenge = challenge
+	out, sample.Attempts, err = askCodex(ctx, auth, model, "", challenge.Instructions, challenge.Prompt, challengeTimeout, func(answer string) (err error) {
+		sample.Text, sample.Parsed, err = fingerprintText(answer, challenge.ExpectedCount)
+		return err
+	}, check)
+	sample.Valid = err == nil
+	if err != nil {
+		sample.Error = truncate(err.Error(), 500)
+	}
+	return
+}
+
+// fingerprintText returns the text of answer that the detector scores and the count of its numbers, or why
+// the answer cannot be scored. Like the upstream detector, only the requested count is scored when an answer runs
+// longer.
+func fingerprintText(answer string, expected int) (text string, parsed int, err error) {
+	if len(answer) > fingerprintMaxText {
+		return "", 0, errors.New("回答过长")
+	}
+	text, numbers := answer, parseNumbers(answer)
+	if len(numbers) > expected {
+		numbers = numbers[:expected]
+		values := make([]string, len(numbers))
+		for i, n := range numbers {
+			values[i] = strconv.Itoa(n)
+		}
+		text = strings.Join(values, ", ")
+	}
+	if len(numbers) < minimumNumbers(expected) {
+		err = errors.New("有效数字不足")
+	}
+	return text, len(numbers), err
+}
