+package codexeval
+
+// Model attribution, ported from Ikaleio/lm-detector (MIT).
+// See data/lm-detector/README.md for the pinned source and license.
+import (
+	"cmp"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
