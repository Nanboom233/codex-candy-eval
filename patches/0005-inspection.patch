+++ b/backend/internal/codexeval/inspection_notify.go
@@ -0,0 +1,50 @@
+package codexeval
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+func SendInspectionNotification(ctx context.Context, s InspectionSettings, title, message string) error {
+	client := &http.Client{Timeout: 30 * time.Second}
+	send := func(channel, endpoint, contentType, body string, auth bool) error {
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, strings.NewReader(body))
+		if err != nil {
+			return fmt.Errorf("%s: invalid notification address", channel)
+		}
+		if contentType != "" {
+			req.Header.Set("Content-Type", contentType)
+		}
+		if auth && s.NtfyPassword != "" {
+			req.SetBasicAuth(s.NtfyUsername, s.NtfyPassword)
+		}
+		resp, err := client.Do(req)
+		if err != nil {
+			return fmt.Errorf("%s: notification request failed", channel)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+			return fmt.Errorf("%s: HTTP %d", channel, resp.StatusCode)
+		}
+		return nil
+	}
+	var failures []error
+	if s.NtfyServer != "" && s.NtfyTopic != "" {
+		endpoint := strings.TrimRight(s.NtfyServer, "/") + "/" + url.PathEscape(s.NtfyTopic) + "?" + url.Values{"title": {title}}.Encode()
+		if err := send("ntfy", endpoint, "text/plain; charset=utf-8", message, true); err != nil {
+			failures = append(failures, err)
+		}
+	}
+	if s.BarkURL != "" {
+		body := url.Values{"title": {title}, "body": {message}}.Encode()
+		if err := send("Bark", s.BarkURL, "application/x-www-form-urlencoded", body, false); err != nil {
+			failures = append(failures, err)
+		}
+	}
+	return errors.Join(failures...)
+}
diff --git a/backend/internal/codexeval/inspection_settings.go b/backend/internal/codexeval/inspection_settings.go
new file mode 100644
index 0000000..d50e766
--- /dev/null
+++ b/backend/internal/codexeval/inspection_settings.go
@@ -0,0 +1,180 @@
+package codexeval
+
+import (
+	"fmt"
+	"net/url"
+	"path"
+	"strings"
+	"time"
+)
+
+type InspectionSettings struct {
+	Enabled                bool     `json:"enabled"`
+	GroupID                int64    `json:"group_id"`
+	AccountType            string   `json:"account_type"`
+	AccountPlan            string   `json:"account_plan"`
+	EnabledOnly            bool     `json:"enabled_only"`
+	Model                  string   `json:"model"`
+	Effort                 string   `json:"effort"`
+	TestType               string   `json:"test_type"`
+	MaxTestsPerAccount     int      `json:"max_tests_per_account"`
+	MinWaitMinutes         int      `json:"min_wait_minutes"`
+	MaxWaitMinutes         int      `json:"max_wait_minutes"`
+	IncludePatterns        []string `json:"include_patterns"`
+	ExcludePatterns        []string `json:"exclude_patterns"`
+	AdjustPriority         bool     `json:"adjust_priority"`
+	ControlModels          bool     `json:"control_models"`
+	NotifyEnabled          bool     `json:"notify_enabled"`
+	DegradedRemoveModels   []string `json:"degraded_remove_models"`
+	NormalPriority         int      `json:"normal_priority"`
+	DegradedPriority       int      `json:"degraded_priority"`
+	NtfyServer             string   `json:"ntfy_server"`
+	NtfyTopic              string   `json:"ntfy_topic"`
+	NtfyUsername           string   `json:"ntfy_username"`
+	NtfyPassword           string   `json:"ntfy_password"`
+	BarkURL                string   `json:"bark_url"`
+	NtfyPasswordConfigured bool     `json:"ntfy_password_configured"`
+	BarkURLConfigured      bool     `json:"bark_url_configured"`
+}
+
+func DefaultInspectionSettings() InspectionSettings {
+	return InspectionSettings{Model: "gpt-6.1-sol", Effort: "low", TestType: "candy", MaxTestsPerAccount: 3, MinWaitMinutes: 15, MaxWaitMinutes: 35,
+		AccountType: "all", AccountPlan: "all", NormalPriority: 10, DegradedPriority: 99, NotifyEnabled: true, NtfyServer: "https://ntfy.sh",
+		IncludePatterns: []string{}, ExcludePatterns: []string{},
+		DegradedRemoveModels: []string{"gpt-6.1-sol", "gpt-6-sol", "gpt-5.6-sol", "gpt-6-astra", "gpt-6.1-terra"}}
+}
+
+func normalizePatternSlice(patterns []string) []string {
+	if len(patterns) == 0 {
+		return []string{}
+	}
+	out := make([]string, 0, len(patterns))
+	seen := make(map[string]bool, len(patterns))
+	for _, pattern := range patterns {
+		pattern = strings.TrimSpace(pattern)
+		if pattern == "" || seen[pattern] {
+			continue
+		}
+		seen[pattern] = true
+		out = append(out, pattern)
+	}
+	return out
+}
+
+func validInspectionAccountType(accountType string) bool {
+	switch accountType {
+	case "all", "oauth", "apikey", "setup-token", "upstream":
+		return true
+	}
+	platform, credType, ok := strings.Cut(accountType, ":")
+	if !ok || platform == "" {
+		return false
+	}
+	for _, r := range platform {
+		if !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '_' || r == '-') {
+			return false
+		}
+	}
+	switch credType {
+	case "oauth", "setup-token", "apikey", "upstream":
+		return true
+	default:
+		return false
+	}
+}
+
+func (s *InspectionSettings) NormalizeModels() {
+	if strings.TrimSpace(s.TestType) == "" {
+		s.TestType = "candy"
+	} else {
+		s.TestType = strings.TrimSpace(s.TestType)
+	}
+	s.IncludePatterns = normalizePatternSlice(s.IncludePatterns)
+	s.ExcludePatterns = normalizePatternSlice(s.ExcludePatterns)
+	if s.DegradedRemoveModels == nil {
+		s.DegradedRemoveModels = DefaultInspectionSettings().DegradedRemoveModels
+	}
+	models := make([]string, 0, len(s.DegradedRemoveModels))
+	seen := make(map[string]bool)
+	for _, model := range s.DegradedRemoveModels {
+		model = strings.TrimSpace(model)
+		if !seen[model] {
+			models = append(models, model)
+			seen[model] = true
+		}
+	}
+	s.DegradedRemoveModels = models
+}
+
+func ValidInspectionRemovalModel(model string) bool {
+	return validModelName(model, true) && !strings.ContainsAny(model, "*?") && model != "blacklist"
+}
+
+func (s InspectionSettings) Public() InspectionSettings {
+	s.NtfyPasswordConfigured = s.NtfyPassword != ""
+	s.BarkURLConfigured = s.BarkURL != ""
+	s.NtfyPassword, s.BarkURL = "", ""
+	return s
+}
+
+func (s InspectionSettings) Validate() error {
+	for _, model := range s.DegradedRemoveModels {
+		if !ValidInspectionRemovalModel(strings.TrimSpace(model)) {
+			return fmt.Errorf("请输入有效的降级移除模型")
+		}
+	}
+	if s.GroupID < 0 || s.Enabled && s.GroupID == 0 {
+		return fmt.Errorf("请选择糖果测试分组")
+	}
+	if !validInspectionAccountType(s.AccountType) {
+		return fmt.Errorf("请选择有效账户类型")
+	}
+	if strings.TrimSpace(s.AccountPlan) == "" {
+		return fmt.Errorf("请选择有效订阅类型")
+	}
+	testType := strings.TrimSpace(s.TestType)
+	if testType == "" {
+		testType = "candy"
+	}
+	if testType != "candy" && testType != "fingerprint" {
+		return fmt.Errorf("请选择有效检查方式")
+	}
+	if !validModelName(strings.TrimSpace(s.Model), testType != "fingerprint") {
+		return fmt.Errorf("请输入有效模型")
+	}
+	for _, pattern := range append(append([]string(nil), s.IncludePatterns...), s.ExcludePatterns...) {
+		pattern = strings.TrimSpace(pattern)
+		if pattern == "" {
+			continue
+		}
+		if _, err := path.Match(pattern, ""); err != nil {
+			return fmt.Errorf("请输入有效的账户匹配通配符")
+		}
+	}
+	if s.MaxTestsPerAccount < 1 || s.MaxTestsPerAccount > candyMaxRuns {
+		return fmt.Errorf("每账户最多测试次数须为 1–%d", candyMaxRuns)
+	}
+	if s.MinWaitMinutes < 1 || s.MaxWaitMinutes < s.MinWaitMinutes {
+		return fmt.Errorf("最长等待时间须不小于最短等待时间，且至少为 1 分钟")
+	}
+	// Duration conversion must remain representable.
+	if int64(s.MaxWaitMinutes) > (1<<63-1)/int64(time.Minute) {
+		return fmt.Errorf("等待时间过长")
+	}
+	if s.NormalPriority < 1 {
+		return fmt.Errorf("正常优先级须至少为 1")
+	}
+	if s.NormalPriority >= s.DegradedPriority {
+		return fmt.Errorf("正常优先级须小于降级优先级")
+	}
+	for _, raw := range []string{s.NtfyServer, s.BarkURL} {
+		if raw == "" {
+			continue
+		}
+		u, err := url.Parse(raw)
+		if err != nil || u.Host == "" || (u.Scheme != "https" && u.Scheme != "http") {
+			return fmt.Errorf("请输入有效的 HTTP 或 HTTPS 通知地址")
+		}
+	}
+	return nil
+}
diff --git a/backend/internal/handler/admin/codex_inspection_handler.go b/backend/internal/handler/admin/codex_inspection_handler.go
new file mode 100644
index 0000000..930b225
--- /dev/null
+++ b/backend/internal/handler/admin/codex_inspection_handler.go
@@ -0,0 +1,181 @@
+package admin
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/codexeval"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+func isInspectionSupportedAccount(a *service.Account) bool {
+	if a == nil {
+		return false
+	}
+	return a.IsOAuth() || a.Type == service.AccountTypeAPIKey || a.Type == service.AccountTypeUpstream
+}
+
+func extractAccountEmail(a *service.Account) string {
+	if a == nil {
+		return ""
+	}
+	for _, key := range []string{"email", "email_address"} {
+		if a.Extra != nil {
+			if v, ok := a.Extra[key].(string); ok && strings.TrimSpace(v) != "" {
+				return strings.TrimSpace(v)
+			}
+		}
+		if v := strings.TrimSpace(a.GetCredential(key)); v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func inspectionAccount(a *service.Account) codexeval.InspectionAccount {
+	enabled, exists := a.Extra["codex_eval_inspection_enabled"].(bool)
+	if !exists {
+		enabled = true
+	}
+	verdict := codexeval.InspectionVerdictNormal
+	if a.Extra["codex_eval_inspection_verdict"] == string(codexeval.InspectionVerdictDegraded) {
+		verdict = codexeval.InspectionVerdictDegraded
+	}
+	return codexeval.InspectionAccount{Target: codexeval.Target{AccountID: a.ID}, Name: a.Name,
+		Email: extractAccountEmail(a), Platform: a.Platform,
+		Priority: a.Priority, Verdict: verdict, Available: a.IsSchedulable(), GroupIDs: a.GroupIDs, Type: a.Type,
+		PlanType: a.GetCredential("plan_type"), Enabled: a.Schedulable, AutoInspectionEnabled: enabled}
+}
+
+func (h *AccountHandler) UpdateCodexInspectionAccount(c *gin.Context) {
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || id <= 0 {
+		response.BadRequest(c, "Invalid account ID")
+		return
+	}
+	var req struct {
+		Enabled *bool `json:"enabled" binding:"required"`
+	}
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	a, err := h.adminService.GetAccount(c.Request.Context(), id)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	if !isInspectionSupportedAccount(a) {
+		response.BadRequest(c, "Account does not support Candy inspection")
+		return
+	}
+	if err := h.adminService.UpdateAccountExtra(c.Request.Context(), id, map[string]any{"codex_eval_inspection_enabled": *req.Enabled}); err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, gin.H{"account_id": id, "enabled": *req.Enabled})
+}
+
+func (h *AccountHandler) inspectionAccounts(ctx context.Context, items []service.Account) []codexeval.InspectionAccount {
+	rows := make([]AccountWithConcurrency, len(items))
+	for n := range items {
+		rows[n].Account = h.accountListResponseFromService(&items[n])
+	}
+	h.enrichShadowParents(ctx, rows)
+	out := make([]codexeval.InspectionAccount, len(items))
+	for n := range items {
+		out[n] = inspectionAccount(&items[n])
+		if out[n].PlanType == "" {
+			out[n].PlanType = rows[n].ParentPlanType
+		}
+	}
+	return out
+}
+
+func (h *AccountHandler) persistInspectionVerdict(ctx context.Context, id int64, verdict codexeval.InspectionVerdict, settings codexeval.InspectionSettings) error {
+	return h.accountTestService.PersistCodexInspectionVerdict(ctx, id, verdict, settings)
+}
+
+func (h *SettingHandler) InitializeCodexInspection(accounts *AccountHandler) {
+	codexeval.InitializeInspection(codexeval.InspectionHooks{
+		Load: h.settingService.GetCodexInspectionSettings,
+		List: func(ctx context.Context, settings codexeval.InspectionSettings) ([]codexeval.InspectionAccount, error) {
+			out := []codexeval.InspectionAccount{}
+			for page := 1; ; page++ {
+				items, total, err := accounts.adminService.ListAccounts(ctx, page, 100, "", "", "", "", settings.GroupID, "", "id", "asc")
+				if err != nil {
+					return nil, err
+				}
+				resolved := accounts.inspectionAccounts(ctx, items)
+				for n := range items {
+					a := &items[n]
+					if isInspectionSupportedAccount(a) {
+						out = append(out, resolved[n])
+					}
+				}
+				if page*100 >= int(total) || len(items) == 0 {
+					break
+				}
+			}
+			return out, nil
+		},
+		Get: func(ctx context.Context, id int64) (codexeval.InspectionAccount, error) {
+			a, err := accounts.adminService.GetAccount(ctx, id)
+			if err != nil {
+				return codexeval.InspectionAccount{}, err
+			}
+			return accounts.inspectionAccounts(ctx, []service.Account{*a})[0], nil
+		},
+		PersistVerdict: accounts.persistInspectionVerdict,
+		UpdatePriority: func(ctx context.Context, id int64, priority int) error {
+			_, err := accounts.adminService.UpdateAccount(ctx, id, &service.UpdateAccountInput{Priority: &priority})
+			return err
+		},
+		Notify: codexeval.SendInspectionNotification,
+	})
+}
+
+func (h *SettingHandler) GetCodexInspectionSettings(c *gin.Context) {
+	s, err := h.settingService.GetCodexInspectionSettings(c.Request.Context())
+	if err != nil {
+		response.Error(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	response.Success(c, s.Public())
+}
+func (h *SettingHandler) UpdateCodexInspectionSettings(c *gin.Context) {
+	var req codexeval.InspectionSettings
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	req.NormalizeModels()
+	if err := req.Validate(); err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	s, err := h.settingService.UpdateCodexInspectionSettings(c.Request.Context(), req)
+	if err != nil {
+		response.Error(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	response.Success(c, s.Public())
+}
+func (h *AccountHandler) CodexInspectionState(c *gin.Context) {
+	response.Success(c, codexeval.CurrentInspectionState())
+}
+func (h *AccountHandler) CodexInspectionStart(c *gin.Context) {
+	if err := codexeval.StartInspection(); err != nil {
+		response.Error(c, http.StatusConflict, err.Error())
+		return
+	}
+	response.Success(c, codexeval.CurrentInspectionState())
+}
+func (h *AccountHandler) CodexInspectionStop(c *gin.Context) {
+	codexeval.CancelInspection()
+	response.Success(c, codexeval.CurrentInspectionState())
+}
