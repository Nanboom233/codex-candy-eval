+  }
+}
+function fillInspectionSettings(settings, preserveDirty = false) {
+  for (const [name, value] of Object.entries(settings)) {
+    const field = inspectionField(name);
+    if (!field || name === "ntfy_password" || preserveDirty && inspectionDirtyFields.has(name)) continue;
+    if (name === "group_id") {
+      const changed = selectedGroup !== value;
+      selectedGroup = value;
+      syncGroupControls();
+      if (changed && accountListReady) {
+        stopPolling(); resetCatalogCache(); credentials = [];
+        for (const selection of [candySelected, fpSelected, plSelected]) selection.clear();
+        load({ refresh: true });
+      }
+    } else if (name === "account_type" || name === "account_plan") {
+      if (![...field.options].some((option) => option.value === value)) field.add(new Option(value, value));
+      field.value = value;
+    } else if (field.type === "checkbox") field.checked = value === true;
+    else if (name === "degraded_remove_models") {
+      field.value = JSON.stringify(value || []);
+      renderInspectionModelTags();
+    }
+    else if (name === "model") updateModelPicker("inspection-model", catalogCache.models?.ids || [], value);
+    else field.value = value ?? "";
+  }
+  if (!preserveDirty || !inspectionDirtyFields.has("enabled")) document.getElementById("inspection-enabled").checked = settings.enabled;
+  inspectionField("ntfy_password").placeholder = settings.ntfy_password_configured ? "已配置，留空保持不变" : "";
+  updateInspectionVisibility();
+}
+function updateInspectionVisibility() {
+  document.getElementById("inspection-auto-fields").hidden = !document.getElementById("inspection-enabled").checked;
+  document.getElementById("inspection-priority-fields").hidden = !inspectionField("adjust_priority").checked;
+  $("inspection-model-fields").hidden = !inspectionField("control_models").checked;
+  $("inspection-notification-fields").hidden = !inspectionField("notify_enabled").checked;
+  if ($("inspection-model-fields").hidden) closeInspectionModels();
+}
+function inspectionRemovedModels() { return JSON.parse(inspectionField("degraded_remove_models").value || "[]"); }
+function setInspectionRemovedModels(models) {
