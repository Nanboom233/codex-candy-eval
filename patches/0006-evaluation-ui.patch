+.native-select > select { appearance: none; padding-right: 32px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
+.btn {
+  --button-bg: var(--accent-soft); --button-hover: var(--accent-soft-hover); --button-ink: var(--accent-ink); --button-line: var(--action-line);
+  display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 16px; border-radius: 9px;
+  border: 1px solid var(--button-line); background: var(--button-bg); color: var(--button-ink); font-weight: 600; cursor: pointer; white-space: nowrap;
+}
+.btn:hover:not(:disabled) { background: var(--button-hover); border-color: var(--button-hover-line, var(--button-line)); }
+.btn .icon { width: 15px; height: 15px; }
+.btn.ghost { --button-bg: var(--control-bg); --button-hover: var(--control-hover); --button-ink: var(--ink); --button-line: var(--control-line); --button-hover-line: var(--control-hover-line); font-weight: 500; height: 32px; padding: 0 12px; }
+.btn.ghost .icon { width: 14px; height: 14px; color: var(--muted); }
+.btn.danger { --button-bg: var(--danger-soft); --button-hover: var(--danger-soft-hover); --button-ink: var(--danger-ink); --button-line: var(--danger-line); --button-hover-line: var(--danger-line); }
+.btn:disabled { --button-bg: var(--control-bg); --button-ink: var(--muted); --button-line: var(--control-line); opacity: .6; cursor: default; }
+.btn.icon-button { width: 32px; padding: 0; }
+input[type="checkbox"] { accent-color: var(--accent); width: 15px; height: 15px; margin: 0; cursor: pointer; }
+.switch { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; }
+.switch > input { appearance: none; position: relative; flex: none; width: var(--switch-width); height: 18px; border-radius: 999px; background: color-mix(in srgb, var(--faint) 55%, var(--line)); transition: background .15s; }
+.switch > input::before { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 20%); transition: transform .15s; }
+.switch > input:checked { background: var(--accent); }
+.switch > input:checked::before { transform: translateX(14px); }
+.switch > input:disabled { opacity: .55; cursor: default; }
+.tip {
+  position: fixed; z-index: 10; width: max-content; max-width: min(320px, calc(100vw - 16px)); padding: var(--tip-padding); pointer-events: none;
+  background: var(--tip-bg); color: var(--tip-ink); border: 1px solid var(--tip-line); border-radius: var(--tip-radius); box-shadow: var(--tip-shadow);
+  backdrop-filter: var(--glass); font-size: 12px; line-height: 1.5; white-space: pre-line; overflow-wrap: anywhere; animation: tip-in .15s ease-out;
+}
+.tip.rich { max-width: min(480px, calc(100vw - 16px)); padding: 8px 10px; white-space: normal; background: var(--popover-bg); color: var(--ink); border-color: var(--popover-line); box-shadow: var(--popover-shadow); }
+@keyframes tip-in { from { opacity: 0; translate: 0 2px; } }
+
+/* Tables and code blocks */
+.fp-detail-scroll, .markdown table { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
+:is(.fp-detail-table, .markdown) :is(th, td) { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); }
+:is(.fp-detail-table, .markdown) th { color: var(--muted); font-weight: 500; background: var(--sunken); }
+:is(.fp-detail-table, .markdown) tr:last-child td { border-bottom: 0; }
+:is(.fp-sample, .markdown) pre { overflow: auto; padding: 12px; background: var(--sunken); border: 1px solid var(--line); border-radius: 8px; font-size: 13px; }
+
+/* Page navigation and introduction */
+header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: var(--section-gap); }
+h1 { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 22px; font-weight: 650; letter-spacing: -0.01em; }
+h1 .icon { width: 26px; height: 26px; color: var(--accent); }
+details.problem { margin-top: 10px; }
+details.problem summary { display: inline-flex; gap: 4px; align-items: center; cursor: pointer; color: var(--muted); font-size: 13px; list-style: none; }
+details.problem summary::-webkit-details-marker { display: none; }
+details.problem summary:hover { color: var(--ink); }
+.chev { width: 15px; height: 15px; transition: transform .15s; }
+details.problem[open] summary .chev, .row.open .toggle .chev { transform: rotate(90deg); }
+.problem-body {
+  position: relative; margin-top: 10px; background: var(--sunken); border: 1px solid var(--line); border-radius: 12px;
+}
+.problem-body pre { margin: 0; padding: 16px 52px 16px 16px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.75; }
+.problem-body code { font: inherit; }
+.copy-btn { position: absolute; top: 8px; right: 8px; display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; padding: 0; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); color: var(--muted); cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; }
+.problem-body:hover .copy-btn, .problem-body:focus-within .copy-btn, .copy-btn.copied { opacity: 1; }
+.copy-btn:hover, .copy-btn.copied { color: var(--accent); border-color: currentColor; }
+.clipboard-buffer { position: fixed; opacity: 0; pointer-events: none; }
+.page-navigation { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: var(--section-gap); }
+/* The padding keeps the tabs' press spring inside the scroll area. */
+.tabs { display: flex; gap: 2px; min-width: 0; padding: 3px; overflow-x: auto; }
+.page-navigation button { flex: none; height: 32px; padding: 0 16px; border: 0; border-radius: calc(var(--radius) - 4px); background: transparent; color: var(--muted); font-weight: 600; white-space: nowrap; cursor: pointer; transition: scale .3s cubic-bezier(.34, 1.56, .64, 1), translate .2s, box-shadow .2s; }
+.page-navigation button:hover:not(:disabled) { color: var(--ink); }
+.page-navigation button:active:not(:disabled) { scale: .95; transition-duration: .08s; }
+.page-navigation button:focus-visible { outline-offset: -2px; }
+.page-navigation button:disabled { opacity: .55; cursor: default; }
+.tab[aria-selected="true"] { background: var(--accent-soft); color: var(--accent-ink); box-shadow: var(--shadow); }
+.tab[aria-selected="true"]:hover { translate: 0 -1px; }
+.page-actions { display: flex; gap: 2px; padding: 3px; }
+.page-actions button { display: inline-flex; align-items: center; justify-content: center; width: 32px; padding: 0; }
+#refresh[aria-busy="true"] .icon { animation: spin .8s linear infinite; }
+.panel-intro { margin-bottom: var(--section-gap); color: var(--muted); }
+.panel-intro p { margin: 0 0 8px; }
+.principle-body { padding: 16px 18px; font-size: 13px; line-height: 1.8; }
+.principle-body p { margin: 0 0 10px; }
+.principle-body p:last-child { margin-bottom: 0; }
+.principle-body a { color: var(--accent-ink); text-underline-offset: 3px; }
+
+/* Result metadata */
+.result-meta, .latest-top { display: flex; align-items: center; gap: 4px 8px; min-width: 0; }
+.result-meta { flex-wrap: wrap; }
+.result-meta .metric { flex: none; max-width: 100%; }
+.result-meta .model-meta .meta { white-space: normal; overflow: visible; overflow-wrap: anywhere; }
+.verdict { display: inline-flex; align-items: center; gap: 4px; flex: none; padding: 1px 8px 1px 6px; border-radius: 999px; background: var(--status-bg, var(--control-bg)); color: var(--status-ink, var(--muted)); font-size: 12px; font-weight: 600; }
+.verdict .icon, .metric .icon { width: 13px; height: 13px; }
+.verdict.ok, .outcome.ok { --status-ink: var(--success-ink); --status-bg: var(--success-soft); }
+.verdict.bad, .outcome.bad { --status-ink: var(--danger-ink); --status-bg: var(--danger-soft); }
+.outcome.warn { --status-ink: var(--warning-ink); --status-bg: var(--warning-soft); }
+.verdict.err, .verdict.skip { border: 1px solid var(--control-line); }
+.meta { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.metrics { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; min-width: 0; max-width: 100%; color: var(--muted); font-size: 12px; }
+.metrics:empty { display: none; }
+.metric { display: inline-flex; align-items: center; gap: 4px; min-width: 0; color: var(--muted); font-size: 12px; line-height: 20px; white-space: nowrap; }
+.metric > .meta { min-width: 0; line-height: inherit; }
+.model-meta { max-width: 100%; }
+.none { color: var(--faint); }
+
+/* Credential lists and history alignment */
+/* Short columns are fixed. Credential, result and model tracks share the rest equally up to their caps;
+   any remaining space is spread evenly across the gaps. */
+#candy-panel { --toolbar-columns: minmax(120px, 180px) 200px 120px 84px minmax(0, 1fr); --list-columns: var(--list-checkbox) var(--credential-track) var(--result-track) 56px var(--marks-width) var(--switch-width) 104px var(--action-width); }
+#fingerprint-panel { --toolbar-columns: minmax(120px, 180px) 200px 84px minmax(0, 1fr); --list-columns: var(--list-checkbox) var(--credential-track) var(--result-track) minmax(104px, 160px) 84px var(--switch-width) var(--action-width); }
+#pelican-panel { --toolbar-columns: minmax(120px, 180px) 200px 120px 120px minmax(138px, 1fr); --preview-scale: .15; --list-columns: var(--list-checkbox) var(--credential-track) var(--result-track) calc(800px * var(--preview-scale)) var(--switch-width) var(--action-width); }
+#pelican-panel .latest-top { flex-wrap: wrap; }
+#pelican-panel .latest-top > .metric:not(.model-meta) { flex: none; }
+#settings-panel { --list-columns: var(--list-checkbox) var(--credential-track) var(--result-track) 56px var(--marks-width) var(--switch-width) var(--action-width); }
+.list-head, .list-row, .history-panel { display: grid; grid-template-columns: var(--list-columns); justify-content: space-between; align-items: center; gap: var(--list-gap); padding-inline: var(--list-padding); }
+.list-head { padding-block: 10px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 12px; }
+.list-head > :nth-child(2) { padding-left: var(--credential-indent); }
+.list-row { padding-block: 14px; min-height: 80px; }
+.row { border-bottom: 1px solid var(--line); }
+.row:last-child { border-bottom: 0; }
+.row-main { cursor: pointer; }
+.select-cell { align-self: stretch; display: flex; align-items: center; }
+.list-row > .btn { width: var(--action-width); height: 36px; padding: 0; }
+.row-main:hover, .row.open .row-main { background: var(--sunken); }
+.credential { min-width: 0; }
+.toggle { display: flex; align-items: center; gap: 4px; min-width: 0; max-width: 100%; padding: 0; border: 0; background: none; font-weight: 600; cursor: pointer; text-align: left; }
+.toggle .chev { color: var(--faint); }
+.toggle .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.credential .api-key, .credential .tags { padding-left: var(--credential-indent); margin-top: 4px; }
+.credential .api-key { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; }
+.credential .tags { display: flex; flex-wrap: wrap; gap: 5px; }
+.credential .name { transition: filter .15s; }
+.masked .credential .name { filter: blur(5px); user-select: none; }
+.tag {
+  display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 0 6px; border-radius: 6px; white-space: nowrap;
+  background: var(--tag-soft, var(--tag-neutral-bg)); border: 1px solid var(--tag-line, var(--tag-neutral-line)); color: var(--tag-ink, var(--tag-neutral-ink)); font-size: 11px; font-weight: 500;
+}
+.tag .icon { width: 12px; height: 12px; }
+.tag > span { overflow: hidden; text-overflow: ellipsis; }
+/* Plan badges follow CPAMC's platinum and gold materials. */
+.plan-elite {
+  --tag-ink: #1f2a38; --tag-line: transparent; font-weight: 700;
+  --tag-soft: linear-gradient(#fff, #e3eaf1 26%, #b4c0cd 45%, #8d9aab 54%, #c9d2dc 78%, #f2f6fa) padding-box,
+    linear-gradient(135deg, #fff, rgb(140 158 178 / 60%) 42%, rgb(56 66 80 / 95%)) border-box;
+  box-shadow: 0 1px 3px rgb(30 42 58 / 28%), inset 0 1px 1px rgb(255 255 255 / 90%), 0 0 10px rgb(150 180 220 / 36%);
+  text-shadow: 0 1px 0 rgb(255 255 255 / 65%);
+}
+.plan-premium { --tag-ink: var(--premium-ink); --tag-soft: var(--premium-soft); --tag-line: var(--premium-line); box-shadow: var(--premium-glow); font-weight: 700; }
+.plan-plus { --tag-ink: var(--plus-ink); --tag-soft: var(--plus-soft); --tag-line: var(--plus-line); }
+.plan-go { --tag-ink: var(--go-ink); --tag-soft: var(--go-soft); --tag-line: var(--go-line); }
+.plan-business { --tag-ink: var(--business-ink); --tag-soft: var(--business-soft); --tag-line: var(--business-line); }
+.tag.warn { --tag-ink: var(--warning-ink); --tag-soft: var(--warning-soft); --tag-line: var(--warning-line); cursor: help; }
+.row-meta { display: contents; }
+.latest { min-width: 0; }
+.history-panel { row-gap: 0; padding-block: 4px 20px; background: var(--sunken); }
+.history-panel > .history-title, .history-panel > .result-history { grid-column: 2 / -1; }
+.section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: var(--heading-padding, 14px var(--list-padding)); border-bottom: 1px solid var(--line); }
+.section-head h2 { margin: 0; font-size: var(--heading-size, 14px); font-weight: 600; }
+.candy-head { flex-wrap: wrap; }
+.inspection-status { display: flex; flex-wrap: wrap; gap: 4px 12px; min-width: 0; font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
+.inspection-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
