+
+  // Alibaba Qwen
+  if (modelLower.includes('qwen') || modelLower.includes('qwq')) return 'qwen'
+
+  // DeepSeek
+  if (modelLower.includes('deepseek')) return 'deepseek'
+
+  // Mistral
+  if (modelLower.includes('mistral') || modelLower.includes('mixtral') ||
+      modelLower.includes('codestral') || modelLower.includes('pixtral') ||
+      modelLower.includes('voxtral') || modelLower.includes('magistral')) return 'mistral'
+
+  // Meta Llama
+  if (modelLower.includes('llama')) return 'meta'
+
+  // Cohere
+  if (modelLower.includes('command') || modelLower.includes('c4ai-') ||
+      modelLower.includes('embed-')) return 'cohere'
+
+  // Yi
+  if (modelLower.startsWith('yi-') || modelLower.startsWith('yi ')) return 'yi'
+
+  // xAI Grok
+  if (modelLower.includes('grok')) return 'xai'
+
+  // Moonshot
+  if (modelLower.includes('moonshot') || modelLower.includes('kimi')) return 'moonshot'
+
+  // Doubao (ByteDance)
+  if (modelLower.includes('doubao')) return 'doubao'
+
+  // MiniMax
+  if (modelLower.includes('abab') || modelLower.includes('minimax')) return 'minimax'
+
+  // Baidu Wenxin
+  if (modelLower.includes('ernie') || modelLower.includes('wenxin')) return 'wenxin'
+
+  // iFlytek Spark
+  if (modelLower.includes('spark')) return 'spark'
+
+  // Tencent Hunyuan
+  if (modelLower.includes('hunyuan')) return 'hunyuan'
+
+  // Cloudflare
+  if (modelLower.includes('@cf/')) return 'cloudflare'
+
+  // Midjourney
+  if (modelLower.includes('mj_') || modelLower.includes('midjourney')) return 'midjourney'
+
+  // Perplexity
+  if (modelLower.includes('perplexity') || modelLower.includes('pplx')) return 'perplexity'
+
+  // Jina
+  if (modelLower.includes('jina')) return 'jina'
+
+  // OpenRouter
+  if (modelLower.includes('openrouter')) return 'openrouter'
+
+  // Suno
+  if (modelLower.includes('suno')) return 'suno'
+
+  // Ollama
+  if (modelLower.includes('ollama')) return 'ollama'
+
+  // 360
+  if (modelLower.includes('360')) return 'ai360'
+
+  // Dify
+  if (modelLower.includes('dify')) return 'dify'
+
+  // Coze
+  if (modelLower.includes('coze')) return 'coze'
+
+  return null
+}
+function inspectionModelIcon(id, size) {
+  const info = INSPECTION_MODEL_ICONS[inspectionModelIconKey(id)];
+  if (!info) return `<span class="model-icon-fallback" style="width:${size}px;height:${size}px;font-size:${size / 2}px" aria-hidden="true">${esc(id.charAt(0).toUpperCase())}</span>`;
+  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">${info.paths.map((path) => `<path d="${path}" fill="${info.color}"/>`).join("")}</svg>`;
+}
+function renderInspectionModelOptions() {
+  const selected = inspectionRemovedModels();
+  const query = $("inspection-model-search").value.trim().toLowerCase();
+  const focused = document.activeElement?.dataset.inspectionModel;
+  const ids = [...new Set([...(catalogCache.models?.ids || []), ...selected])].sort(compareModels);
+  $("inspection-model-options").innerHTML = ids.filter((id) => id.toLowerCase().includes(query)).map((id) => `<button type="button" class="model-option" data-inspection-model="${esc(id)}" aria-pressed="${selected.includes(id)}"><span class="model-option-check" aria-hidden="true">${selected.includes(id) ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' : ""}</span>${inspectionModelIcon(id, 18)}<span>${esc(id)}</span></button>`).join("");
+  if (focused) [...$("inspection-model-options").children].find((button) => button.dataset.inspectionModel === focused)?.focus();
+}
+function closeInspectionModels(returnFocus = false) {
+  $("inspection-model-dropdown").hidden = true;
+  $("inspection-model-trigger").setAttribute("aria-expanded", "false");
+  if (returnFocus) $("inspection-model-trigger").focus();
+}
+function initializeInspectionModels() {
+  const custom = $("inspection-model-custom");
+  const add = () => {
+    const id = custom.value.trim();
+    if (!id) return;
+    custom.setCustomValidity(id.length > 200 || /[\u0000-\u001f\u007f-\u009f*?]/.test(id) || id === "blacklist" ? "请输入有效的降级移除模型" : "");
+    if (!custom.checkValidity()) { inspectionMessage(custom.validationMessage, true); return; }
+    const selected = inspectionRemovedModels();
+    if (!selected.includes(id)) setInspectionRemovedModels([...selected, id]);
+    custom.value = "";
+  };
+  custom.addEventListener("input", () => custom.setCustomValidity(""));
+  custom.addEventListener("keydown", (event) => {
+    if (event.key === "Enter" && !event.isComposing) { event.preventDefault(); add(); }
+  });
+  $("inspection-model-add").addEventListener("click", add);
+  $("inspection-model-tags").addEventListener("click", (event) => {
+    const button = event.target.closest("[data-remove-model]");
+    if (!button) return;
+    event.stopPropagation();
+    setInspectionRemovedModels(inspectionRemovedModels().filter((id) => id !== button.dataset.removeModel));
+    $("inspection-model-trigger").focus();
+  });
+  $("inspection-model-field").addEventListener("click", () => {
+    if (!$("inspection-model-dropdown").hidden) return closeInspectionModels();
+    $("inspection-model-search").value = "";
+    renderInspectionModelOptions();
+    $("inspection-model-dropdown").hidden = false;
+    $("inspection-model-trigger").setAttribute("aria-expanded", "true");
+    $("inspection-model-search").focus();
+  });
+  $("inspection-model-search").addEventListener("input", renderInspectionModelOptions);
+  $("inspection-model-options").addEventListener("click", (event) => {
+    const button = event.target.closest("[data-inspection-model]");
+    if (!button) return;
+    const id = button.dataset.inspectionModel, selected = inspectionRemovedModels();
+    setInspectionRemovedModels(selected.includes(id) ? selected.filter((value) => value !== id) : [...selected, id]);
+  });
+  $("inspection-model-picker").addEventListener("keydown", (event) => {
+    if (event.key === "Escape" && !$("inspection-model-dropdown").hidden) { event.preventDefault(); closeInspectionModels(true); }
+  });
+  document.addEventListener("click", (event) => {
+    if (!$("inspection-model-picker").contains(event.target)) closeInspectionModels();
+  });
+}
+async function loadInspectionSettings() {
+  if (inspectionSettingsLoading || inspectionSettingsSaving) return;
+  inspectionSettingsLoading = true;
+  try {
+    const generation = inspectionSettingsGeneration;
+    const settings = await api(INSPECTION_SETTINGS);
+    if (sessionBlocked) return;
+    if (generation === inspectionSettingsGeneration) {
+      fillInspectionSettings(settings, true);
+      inspectionSettingsLoaded = true;
+      if (inspectionDirtyFields.size) scheduleInspectionSave();
+    }
+    await loadInspectionState();
+  } catch (err) {
+    if (err instanceof AuthError) return showLogin(err.message);
+    inspectionMessage(err.message, true);
+  } finally { inspectionSettingsLoading = false; }
+}
+function renderInspectionState(state) {
+  inspectionState = state;
+  const phase = state.cancelling ? "正在停止" : ({ testing: "正在测试", recovery_wait: "等待恢复确认", cancelled: "巡检已停止" })[state.phase] || "";
+  document.getElementById("inspection-phase").textContent = phase;
+  document.getElementById("inspection-next").textContent = state.next_run_at ? "下次巡检：" + fmtTime(state.next_run_at, false) : "";
+  document.getElementById("inspection-progress").textContent = state.running && state.started_at ? `账户进度：${state.done}/${state.total}` : "";
+  document.getElementById("inspection-status").hidden = !phase && !state.next_run_at && !document.getElementById("inspection-progress").textContent;
+  document.getElementById("inspection-start").disabled = !inspectionSettingsLoaded || state.running || inspectionActionPending;
+  document.getElementById("inspection-stop").disabled = !state.running || state.cancelling || inspectionActionPending;
+  renderCandy();
+}
+async function loadInspectionState() {
+  clearTimeout(inspectionTimer);
+  inspectionStateController?.abort();
+  const controller = new AbortController();
+  inspectionStateController = controller;
+  const signal = controller.signal;
+  try {
+    const state = await api(BASE + "/inspection/state", { signal });
+    if (signal.aborted || sessionBlocked) return;
+    renderInspectionState(state);
+  } catch (err) {
+    if (signal.aborted) return;
+    if (err instanceof AuthError) return showLogin(err.message);
+  } finally {
+    if (inspectionStateController === controller && !$("app").hidden && !sessionBlocked) {
+      inspectionTimer = setTimeout(loadInspectionState, inspectionState.running ? 2500 : 20000);
+    }
+  }
+}
+function validateInspectionFields() {
+  const min = inspectionField("min_wait_minutes"), max = inspectionField("max_wait_minutes");
+  max.setCustomValidity(Number(max.value) < Number(min.value) ? "最长等待须不小于最短等待" : "");
+  const normal = inspectionField("normal_priority"), degraded = inspectionField("degraded_priority");
+  const invalidPriorityPair = Number(normal.value) >= Number(degraded.value);
+  degraded.setCustomValidity(invalidPriorityPair ? "降级优先级须大于正常优先级" : "");
+}
+function markInspectionEdit(name) {
+  inspectionDirtyFields.set(name, ++inspectionFormRevision);
+  scheduleInspectionSave();
+}
+function scheduleInspectionSave() {
+  clearTimeout(inspectionAutosaveTimer);
+  inspectionAutosaveTimer = setTimeout(saveInspectionSettings, 400);
+}
+async function saveInspectionSettings() {
+  clearTimeout(inspectionAutosaveTimer);
+  if (inspectionSavePromise) {
+    const saved = await inspectionSavePromise;
+    if (!saved) return false;
+    return inspectionDirtyFields.size ? saveInspectionSettings() : true;
+  }
+  if (!inspectionSettingsLoaded || !inspectionDirtyFields.size || sessionBlocked) return false;
+  const form = inspectionForm();
+  validateInspectionFields();
+  const invalid = [...form.elements].find((field) => field.willValidate && !field.checkValidity());
+  if (invalid) { inspectionMessage(invalid.validationMessage, true); return false; }
+  if ($("inspection-enabled").checked && !selectedGroup) { inspectionMessage("请选择糖果测试分组", true); return false; }
+  const body = { enabled: $("inspection-enabled").checked, group_id: selectedGroup,
+    account_type: $("credential-type").value, account_plan: $("credential-plan").value, enabled_only: $("enabled-only").checked };
+  for (const field of form.elements) {
+    if (!field.name) continue;
+    body[field.name] = field.name === "degraded_remove_models" ? inspectionRemovedModels()
+      : field.type === "checkbox" ? field.checked : field.type === "number" ? Number(field.value)
+      : field.name === "ntfy_password" && !inspectionDirtyFields.has(field.name) ? ""
+      : field.type === "password" ? field.value : field.value.trim();
+  }
+  inspectionSettingsSaving = true;
+  inspectionSettingsGeneration++;
+  const revision = inspectionFormRevision;
+  const submittedFields = new Map(inspectionDirtyFields);
+  form.setAttribute("aria-busy", "true");
+  inspectionSavePromise = (async () => {
+    try {
+      const saved = await api(INSPECTION_SETTINGS, { method: "PUT", body });
+      if (sessionBlocked) return false;
+      for (const [name, version] of submittedFields) {
+        if (inspectionDirtyFields.get(name) === version) inspectionDirtyFields.delete(name);
+      }
+      fillInspectionSettings(saved, true);
+      inspectionMessage("");
+      await loadInspectionState();
+      return true;
+    } catch (err) {
+      if (err instanceof AuthError) { showLogin(err.message); return false; }
+      inspectionMessage(err.message, true);
+      return false;
+    } finally {
+      inspectionSettingsSaving = false;
+      form.setAttribute("aria-busy", "false");
+      inspectionSavePromise = null;
+      if (!sessionBlocked && revision !== inspectionFormRevision && inspectionDirtyFields.size) scheduleInspectionSave();
+    }
+  })();
+  return inspectionSavePromise;
+}
+function initializeInspection() {
+  const form = inspectionForm();
+  initializeInspectionModels();
+  inspectionField("effort").innerHTML = `<option value="">未指定</option>` + DEFAULT_EFFORTS.map((value) => `<option>${value}</option>`).join("");
+  const changed = (event) => {
+    const name = event.target.name || (event.target.id === "inspection-enabled" ? "enabled" : "");
+    if (!name || name === "ntfy_password" && event.type === "change") return;
+    updateInspectionVisibility();
+    markInspectionEdit(name);
+  };
+  form.addEventListener("input", changed);
+  form.addEventListener("change", changed);
+  form.addEventListener("submit", (event) => { event.preventDefault(); saveInspectionSettings(); });
+  for (const [name, id] of Object.entries(CANDY_SELECTION_FIELDS)) {
+    const controls = name === "group_id" ? document.querySelectorAll("[data-group-select]") : [$(id)];
+    for (const control of controls) control.addEventListener("change", () => markInspectionEdit(name));
+  }
+  for (const action of ["start", "stop"]) document.getElementById("inspection-" + action).addEventListener("click", async () => {
+    if (inspectionActionPending) return;
+    inspectionActionPending = true;
+    document.getElementById("inspection-" + action).disabled = true;
+    try {
+      if (action === "start" && inspectionDirtyFields.size && !await saveInspectionSettings()) return;
+      renderInspectionState(await api(BASE + "/inspection/" + action, { method: "POST", body: {} }));
+      if (action === "start") await load();
+    }
+    catch (err) {
+      if (err instanceof AuthError) return showLogin(err.message);
+    } finally { inspectionActionPending = false; if (!sessionBlocked) await loadInspectionState(); }
+  });
+}
diff --git a/backend/internal/codexeval/web/pelican.js b/backend/internal/codexeval/web/pelican.js
new file mode 100644
index 0000000..737e3b3
--- /dev/null
+++ b/backend/internal/codexeval/web/pelican.js
@@ -0,0 +1,110 @@
+"use strict";
+const PELICAN_VARIANTS = /*PELICAN_VARIANTS*/[];
+const plSelected = new Set();
+const plExpanded = new Set();
+const plSavePrefs = () => store(PREF_STORE + ".pelican", { model: $("pl-model").value, effort: $("pl-effort").value, variant: $("pl-variant").value });
+const plVariant = (id) => PELICAN_VARIANTS.find((v) => v.id === id);
+const plVariantMeta = (r) => metric("image", "版本", plVariant(r.variant)?.label || r.variant);
+function updatePelicanPrompt() {
+  $("pl-prompt").textContent = plVariant($("pl-variant").value).prompt;
+}
+
+const plKind = (r) => (r.skipped ? "skip" : r.error ? "err" : "ok");
+const PL_VERDICT = { ok: "已生成", err: "未生成", skip: "已跳过" };
+const plVerdict = (r) => statusPill(plKind(r), PL_VERDICT[plKind(r)]);
+
+// Lists carry summaries, so each page loads once per record: undefined while loading, an Error when it failed.
+const pelicanPages = new Map();
+const pelicanKey = (credentialID, recordID) => JSON.stringify([credentialID, recordID]);
+function pelicanPage(credentialID, recordID) {
+  const key = pelicanKey(credentialID, recordID);
+  if (!pelicanPages.has(key)) {
+    pelicanPages.set(key, undefined);
+    const settle = (page) => {
+      if (!pelicanPages.has(key)) return;
+      pelicanPages.set(key, page);
+      renderPelican();
+    };
+    api(`${BASE}/records/pelican/${Number(credentialID)}/${encodeURIComponent(recordID)}`)
+      .then((r) => settle(r.pelican.html), (err) => err instanceof AuthError ? showLogin(err.message) : settle(err));
+  }
+  return pelicanPages.get(key);
+}
+
+// Model pages run sandboxed: their scripts work, but this page's origin and storage stay out of reach, and
+// the CSP they inherit from it blocks external assets.
+const pelicanFrame = (html) => `<iframe sandbox="allow-scripts" srcdoc="${esc(html)}" title="鹈鹕画面" loading="lazy" tabindex="-1"></iframe>`;
+// Previews show a page as it looks a second after it is first drawn, then hold its animations and stop its
+// timers, so a long list costs no CPU; only the dialog plays the page. Frames in a hidden tab can load without
+// being drawn, and Chrome restarts CSS animations whenever a frame is drawn again, hence the wait for a frame
+// and the hold on every animation start.
+const PREVIEW_FREEZE = `<script>addEventListener("load", () => requestAnimationFrame(() => setTimeout(() => {
+  const hold = () => document.getAnimations().forEach((animation) => { animation.pause(); animation.currentTime = 1000; });
+  hold();
+  addEventListener("animationstart", hold);
+  document.querySelectorAll("svg").forEach((svg) => svg.pauseAnimations());
+  for (let id = setTimeout(() => {}); id > 0; id--) { clearTimeout(id); clearInterval(id); }
+  window.requestAnimationFrame = window.setTimeout = window.setInterval = () => 0;
+}, 1000)));<\/script>`;
+function pelicanPreview(credentialID, r) {
+  if (r.error) return `<div class="preview" data-tip="${esc(r.error)}">${icon(STATUS_ICONS[plKind(r)])}</div>`;
+  const page = pelicanPage(credentialID, r.id);
+  if (page instanceof Error) return `<div class="preview" data-tip="${esc("画面加载失败：" + page.message)}">${icon("circle-alert")}</div>`;
+  return `<div class="preview">${page === undefined ? icon("loader-circle", "spin") : pelicanFrame(page + PREVIEW_FREEZE)}
+    <button class="preview-open" type="button" data-pl-detail="${esc(r.id)}" data-pl-credential="${esc(credentialID)}" aria-label="${esc(`放大查看 ${fmtTime(r.time)} 的画面`)}"></button></div>`;
+}
+
+function pelicanHistory(a, r) {
+  return historyCard(r, r.error ? `${plVerdict(r)}<span class="${r.skipped ? "meta" : "detail-warning"}">${esc(r.error)}</span>` : pelicanPreview(a.id, r), plVariantMeta(r));
+}
+
+function renderPelicanRow(a) {
+  const history = a.pelicans || [], last = history.at(-1);
+  const button = a.pelican_running
+    ? `<button class="btn ghost" type="button" data-tip="正在等待模型生成画面" disabled>${icon("loader-circle", "spin")}测试中</button>`
+    : collectionButton("pl", a, null, "测试");
+  return credentialRow({
+    type: "pl", credential: a, selected: plSelected.has(a.id), open: plExpanded.has(a.id), selectable: runnable("pl-", a), button,
+    result: latestResult(last, (r) => plVerdict(r) + plVariantMeta(r)), tested: !!last, meta: last ? pelicanPreview(a.id, last) : `<span class="none">—</span>`,
+    history: () => [...history].reverse().map((r) => pelicanHistory(a, r)).join(""),
+  });
+}
+
+function renderPelican() {
+  renderSelection("pl-", plSelected, "测试");
+  $("pl-clear").disabled = pending || !credentials.some((a) => a.pelicans?.length);
+  renderList("pl-", renderPelicanRow);
+}
+
+function runPelican(body) {
+  if (!$("pl-toolbar").reportValidity()) return;
+  plSavePrefs();
+  return update("/start", { method: "POST", body: { type: "pelican", ...body, model: $("pl-model").value, effort: $("pl-effort").value, variant: $("pl-variant").value } }, "开始测试失败");
+}
+
+function showPelicanDetail(r) {
+  $("pl-detail-body").innerHTML = `<div class="result-dialog-meta record-meta">${recordMeta(r, plVariantMeta(r))}</div>
+    <div class="preview pelican-stage">${pelicanFrame(r.html)}</div>`;
+  fitPelicanStage();
+}
+function fitPelicanStage() {
+  const stage = $("pl-detail-body").querySelector(".pelican-stage");
+  stage?.style.setProperty("--preview-scale", stage.clientWidth / 800);
+}
+
+function initializePelican() {
+  fillSelect("pl-effort", DEFAULT_EFFORTS, stored(PREF_STORE + ".pelican")?.effort, DEFAULT_EFFORT);
+  fillSelect("pl-variant", PELICAN_VARIANTS.map((v) => [v.id, v.label]), stored(PREF_STORE + ".pelican")?.variant, "original");
+  updatePelicanPrompt();
+  const changeVariant = () => {
+    store(PREF_STORE + ".pelican", { ...stored(PREF_STORE + ".pelican"), variant: $("pl-variant").value });
+    updatePelicanPrompt();
+  };
+  for (const event of ["input", "change"]) $("pl-variant").addEventListener(event, changeVariant);
+  for (const id of ["pl-model", "pl-effort"]) $(id).addEventListener("input", plSavePrefs);
+  for (const id of ["pl-model", "pl-effort"]) $(id).addEventListener("change", plSavePrefs);
+  // Closing the dialog also stops its animation.
+  $("pl-detail").addEventListener("close", () => { $("pl-detail-body").innerHTML = ""; });
+  addEventListener("resize", fitPelicanStage);
+  bindCollectionActions({ type: "pl", scope: "pelican", expanded: plExpanded, renderRows: renderPelican, run: runPelican, showDetail: showPelicanDetail });
+}
diff --git a/backend/internal/codexeval/web/style.css b/backend/internal/codexeval/web/style.css
