+  $("mt-credentials").innerHTML = credentialCard("mt-", "ModelTrace 测试", ["账户", "归因结果", "测试模型", "测试时间"]);
+  $("pl-credentials").innerHTML = credentialCard("pl-", "鹈鹕测试", ["账户", "最近一次", "动画"]);
+  $("notifications").innerHTML = ["flash", "load-error", "catalog-error", "storage-error"].map((id) => `<div id="${id}" class="global-flash" role="alert" hidden><span class="notice-symbol" aria-hidden="true"></span><span class="notice-message"></span><button class="notice-close" type="button" aria-label="隐藏提示" data-tip>${icon("x")}</button></div>`).join("");
+}
+
+// Events and initialization.
+initializeLayout();
+initializeModelPickers();
+initializeTips();
+initializeCopyButtons();
+initializeCandy();
+initializeFingerprint();
+initializeModelTrace();
+initializePelican();
+initializeInspection();
+document.querySelectorAll("[data-icon]").forEach((el) => { el.outerHTML = icon(el.dataset.icon, el.dataset.class); });
+
+for (const id of ["flash", "load-error", "catalog-error", "storage-error"]) {
+  $(id).querySelector(".notice-close").addEventListener("click", () => hideNotice(id));
+}
+
+$("refresh").addEventListener("click", async () => {
+  if (pending) return;
+  resetCatalogCache();
+  refreshing = true;
+  try {
+    await load({ refresh: true });
+  } finally {
+    refreshing = false;
+    renderPageActions();
+  }
+});
+
+applyTheme();
+addEventListener("storage", applyTheme);
+matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyTheme);
+
+setMasked(stored(MASK_STORE) === true);
+$("mask").addEventListener("click", () => {
+  const masked = !document.body.classList.contains("masked");
+  setMasked(masked);
+  store(MASK_STORE, masked);
+});
+for (const id of ["fp-mask", "mt-mask", "pl-mask"]) $(id).addEventListener("click", () => $("mask").click());
+
+for (const [id, scope] of [["clear", "candy"], ["fp-clear", "fingerprint"], ["mt-clear", "modeltrace"], ["pl-clear", "pelican"], ["clear-all", "all"]]) {
+  $(id).addEventListener("click", () => {
+    clearScope = scope;
+    $("clear-title").textContent = `${$(id).getAttribute("aria-label")}？`;
+    $("confirm-clear").returnValue = ""; // Esc keeps the previous returnValue.
+    $("confirm-clear").showModal();
+  });
+}
+$("confirm-clear").addEventListener("close", () => {
+  if ($("confirm-clear").returnValue !== "confirm") return;
+  update("/clear-history", { method: "POST", body: { scope: clearScope } }, "清空测试记录失败");
+});
+
+for (const name of tabNames) {
+  $("tab-" + name).addEventListener("click", () => switchTab(name));
+  $("tab-" + name).addEventListener("keydown", (e) => {
+    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) return;
+    e.preventDefault();
+    const next = e.key === "Home" ? tabNames[0] : e.key === "End" ? tabNames.at(-1) : tabNames[(tabNames.indexOf(name) + (e.key === "ArrowRight" ? 1 : -1) + tabNames.length) % tabNames.length];
+    switchTab(next); $("tab-" + next).focus();
+  });
+}
+switchTab(tabNames.includes(stored(PREF_STORE + ".tab")) ? stored(PREF_STORE + ".tab") : "candy");
+
+for (const [prefix, type, selection, submit] of [["", "candy", candySelected, runCandy], ["fp-", "fp", fpSelected, runFingerprint], ["mt-", "mt", mtSelected, runModelTrace], ["pl-", "pl", plSelected, runPelican]]) {
+  for (const filter of ["credential-type", "credential-plan", "enabled-only"]) $(prefix + filter).addEventListener("change", () => { selection.clear(); render(); });
+  $(prefix + "toolbar").addEventListener("submit", (e) => {
+    e.preventDefault();
+    const ids = batchCredentials(prefix, selection).map((a) => a.id);
+    if (ids.length) submit({ targets: targetsFor(ids) });
+  });
+  $(prefix + "select-all").addEventListener("change", (e) => {
+    for (const a of visibleCredentials(prefix)) {
+      if (!e.target.checked) selection.delete(a.id);
+      else if (availableCredential(a)) selection.add(a.id);
+    }
+    render();
+  });
+  $(prefix + "rows").addEventListener("change", (e) => {
+    if (e.target.dataset.enable) return setCredentialEnabled(e.target.dataset.enable, e.target.checked);
+    const id = e.target.getAttribute(`data-${type}-select`);
+    if (!id) return;
+    e.target.checked ? selection.add(id) : selection.delete(id);
+    render();
+  });
+}
+document.querySelectorAll("[data-group-select]").forEach((select) => select.addEventListener("change", () => {
+ selectedGroup = Number(select.value);
+ store(PREF_STORE + ".group", selectedGroup);
+ stopPolling(); resetCatalogCache(); credentials = [];
+ for (const selection of [candySelected, fpSelected, mtSelected, plSelected]) selection.clear();
+ syncGroupControls(); load({ refresh: true });
+}));
+localStorage.getItem("auth_token") ? start() : showLogin("请登录 Sub2API 管理面板，登录后刷新本页");
diff --git a/backend/internal/codexeval/web/candy.js b/backend/internal/codexeval/web/candy.js
new file mode 100644
--- /dev/null
+++ b/backend/internal/codexeval/web/candy.js
@@ -0,0 +1,115 @@
+"use strict";
+
+const candyExpanded = new Set();
+const candyAnswersExpanded = new Set();
+const candySelected = new Set();
+
+const candyPrefs = () => stored(PREF_STORE) || {};
+const candySavePrefs = () => store(PREF_STORE, { model: $("model").value, effort: $("effort").value, runs: candyRuns() });
+const candyRuns = () => boundedInput("runs", 1, 10);
+
+const scopeMatch = (r) => r.model === $("model").value && (r.effort || "none") === $("effort").value;
+const kind = (r) => (r.skipped ? "skip" : r.error ? "err" : r.ok ? "ok" : "bad");
+const VERDICT = { ok: "答对", bad: "答错", err: "出错", skip: "已跳过" };
+const verdict = (r) => statusPill(kind(r), VERDICT[kind(r)]);
+const resultMeta = (r) => `<div class="result-meta">${verdict(r)}${metric("calendar", "测试时间", fmtTime(r.time))}${modelMeta(r)}</div>`;
+// Answers come from untrusted upstreams: raw HTML is escaped, links and images stay text, and Temml
+// refuses commands that need trust, such as \href. The CJK plugin lets emphasis close after full-width
+// punctuation, as in **答案：**21.
+const markdown = markdownit({ breaks: true }).disable(["link", "image", "autolink"])
+  .use(markdownItCjkFriendly).use(texmath, { engine: temml, delimiters: ["dollars", "brackets"] });
+const answerHTML = (r) => r.error ? esc(r.error) : markdown.render(r.answer || "");
+const answerKey = (id, r) => JSON.stringify([id, r.time, r.model, r.effort]);
+const answerToggle = (open) => `${icon("chevron-right", "chev")}${open ? "收起" : "展开"}`;
+
+function candyHistory(a, r, i) {
+  const key = answerKey(a.id, r);
+  const answerOpen = candyAnswersExpanded.has(key);
+  const bodyID = `answer-${encodeURIComponent(a.id)}-${i}`;
+  return historyCard(r, `<div class="answer ${answerOpen ? "expanded" : ""}">${verdict(r)}
+    <button class="answer-toggle" type="button" data-answer="${esc(key)}" aria-expanded="${answerOpen}" aria-controls="${esc(bodyID)}" aria-label="${answerOpen ? "收起文本" : "展开文本"}">${answerToggle(answerOpen)}</button>
+    <div id="${esc(bodyID)}" class="answer-content ${r.error ? "error" : "markdown"}">${answerHTML(r)}</div>
+  </div>`);
+}
+
+function renderCandyRow(a) {
+  const results = a.results;
+  const last = results[results.length - 1];
+  const graded = results.filter((r) => scopeMatch(r) && !r.error && !r.skipped);
+  const correct = graded.filter((r) => r.ok).length;
+
+  const rate = graded.length
+    ? `<b class="mono">${Math.round((correct / graded.length) * 100)}%</b><small class="mono">${correct}/${graded.length}</small>`
+    : `<span class="none">—</span>`;
+  const marks = results.map((r, i) => `<button class="mark-hit" type="button" data-auth="${esc(a.id)}" data-i="${i}" aria-label="${esc(`${fmtTime(r.time)} ${modelName(r)} ${VERDICT[kind(r)]}`)}">${icon(STATUS_ICONS[kind(r)], `mark ${kind(r)} ${scopeMatch(r) ? "" : "dim"}`)}</button>`).join("");
+  const progress = a.running && `${a.running.done}/${a.running.total}`;
+  const blocker = runBlocker("", a);
+  const button = progress
+    ? `<button class="btn ghost" type="button" aria-label="测试中 ${progress}" data-tip disabled>${icon("loader-circle", "spin")}<span class="mono">${progress}</span></button>`
+    : `<button class="btn" type="button" data-candy-run="${esc(a.id)}" ${disabledFor(blocker)}>${icon("play")}测试</button>`;
+
+  return credentialRow({
+    type: "candy", credential: a, selected: candySelected.has(a.id), open: candyExpanded.has(a.id), selectable: !blocker, button,
+    result: latestResult(last, verdict), meta: `<div class="rate">${rate}</div><div class="marks">${marks}</div>`, tested: results.length > 0,
+    history: () => [...results].reverse().map((r, i) => candyHistory(a, r, i)).join(""),
+  });
+}
+
+function runCandy(body) {
+  if (!$("toolbar").reportValidity()) return;
+  candySavePrefs();
+  return update("/start", { method: "POST", body: { type: "candy", ...body, model: $("model").value, effort: $("effort").value, runs: candyRuns() } }, "开始测试失败");
+}
+
+function candyTip(target) {
+  const r = credentials.find((a) => a.id === target.dataset.auth)?.results[target.dataset.i];
+  return r ? `${resultMeta(r)}
+    <div class="metrics">${r.skipped ? "" : metrics(r)}</div>
+    <div class="tip-text ${r.error ? "error" : "markdown"}">${answerHTML(r)}</div>` : "";
+}
+
+function renderCandy() {
+  $("rate-scope").textContent = `正确率按 ${modelName({ model: $("model").value, effort: $("effort").value })} 统计`;
+  renderSelection("", candySelected, "测试");
+  $("clear").disabled = pending || credentials.every((a) => !a.results.length);
+  renderList("", renderCandyRow);
+}
+
+function initializeCandy() {
+  const saved = candyPrefs();
+  fillSelect("effort", DEFAULT_EFFORTS, saved.effort, DEFAULT_EFFORT);
+  $("runs").value = saved.runs || 1;
+  $("runs").value = candyRuns();
+
+  for (const id of ["model", "effort", "runs"]) $(id).addEventListener("input", candySavePrefs);
+  $("model").addEventListener("change", () => { candySavePrefs(); render(); });
+  $("effort").addEventListener("change", () => { candySavePrefs(); render(); });
+  $("runs").addEventListener("change", () => { $("runs").value = candyRuns(); candySavePrefs(); });
+  bindCandyRows();
+}
+
+function bindCandyRows() {
+  $("rows").addEventListener("click", (e) => {
+    if (e.target.closest("label")) return;
+    const hit = e.target.closest("[data-auth]");
+    if (hit) return showTip(hit);
+    const toggle = e.target.closest("[data-answer]");
+    if (toggle) {
+      const key = toggle.dataset.answer;
+      const open = !candyAnswersExpanded.has(key);
+      open ? candyAnswersExpanded.add(key) : candyAnswersExpanded.delete(key);
+      toggle.closest(".answer").classList.toggle("expanded", open);
+      toggle.setAttribute("aria-expanded", open);
+      toggle.setAttribute("aria-label", open ? "收起文本" : "展开文本");
+      toggle.innerHTML = answerToggle(open);
+      return;
+    }
+    const btn = e.target.closest("[data-candy-run]");
+    if (btn) return runCandy({ targets: targetsFor([btn.dataset.candyRun]) });
+    const row = e.target.closest("[data-row]");
+    if (!row) return;
+    const id = row.dataset.row;
+    candyExpanded.has(id) ? candyExpanded.delete(id) : candyExpanded.add(id);
+    render();
+  });
+}
diff --git a/backend/internal/codexeval/web/catalog.js b/backend/internal/codexeval/web/catalog.js
new file mode 100644
--- /dev/null
+++ b/backend/internal/codexeval/web/catalog.js
@@ -0,0 +1,123 @@
+"use strict";
+let groups = [];
+let selectedGroup = 0;
+let accountList = [];
+let accountListReady = false;
+let accountListGroup = 0;
+let accountListError = "";
+let catalogCache = { models: null };
+let catalogLoaded = false;
+let catalogGroup = 0;
+let catalogGeneration = 0;
+function resetCatalogCache() {
+  catalogGeneration++;
+  catalogLoaded = false;
+  catalogGroup = 0;
+  catalogCache = { models: null };
+  accountList = [];
+  accountListReady = false;
+  accountListGroup = 0;
+  accountListError = "";
+}
+function syncGroupControls() {
+  const options = groups.map((g) => [String(g.id), g.name]);
+  if (selectedGroup && !groups.some((g) => g.id === selectedGroup)) options.push([String(selectedGroup), `分组 ${selectedGroup}（不可用）`]);
+  for (const prefix of ["", "fp-", "mt-", "pl-"]) {
+    fillSelect(prefix + "group", options, String(selectedGroup), String(selectedGroup));
+  }
+}
+// Keep the original model ordering; IDs are sent without CPA suffix conversion.
+function compareModels(a, b) {
+  const name = (id) => id.toLowerCase().split("/").pop();
+  const group = (id) => id.startsWith("gpt-") ? 0 : id.split("(")[0] === "codex-auto-review" ? 1 : id.startsWith("claude-") ? 2 : 3;
+  const left = name(a), right = name(b), family = group(left) - group(right);
+  const lexical = (x, y) => x < y ? -1 : x > y ? 1 : 0;
+  if (family) return family;
+  if (group(left) === 0) {
+    const generation = /^gpt-(\d+(?:\.\d+)*)(?:-(astra|sol|terra|luna))?(?=[-(]|$)/;
+    const l = left.match(generation), r = right.match(generation);
+    if (l && r) {
+      const lv = l[1].split(".").map(Number), rv = r[1].split(".").map(Number);
+      for (let i = 0; i < Math.max(lv.length, rv.length); i++) {
+        const version = (rv[i] || 0) - (lv[i] || 0);
+        if (version) return version;
+      }
+      const tiers = ["astra", "sol", "terra", "luna"];
+      const rank = (tier) => tier ? tiers.indexOf(tier) : tiers.length;
+      const tier = rank(l[2]) - rank(r[2]);
+      if (tier) return tier;
+    }
+  }
+  return (group(left) < 3 ? lexical(right, left) : lexical(left, right)) || lexical(a, b);
+}
+
+async function refreshCatalog({ signal, force = false } = {}) {
+  const reuseModels = catalogLoaded && catalogGroup === selectedGroup && !force;
+  const previousModelAccounts = enabledAccountIDs(accountList);
+  accountListReady = false;
+  accountListError = "";
+  catalogLoaded = false;
+  const generation = ++catalogGeneration;
+  const initialGroup = selectedGroup;
+  const current = () => generation === catalogGeneration && !signal?.aborted;
+  try {
+    const available = reuseModels ? groups : await api("/api/v1/admin/groups/all?platform=openai", { signal });
+    if (!current() || selectedGroup !== initialGroup) return;
+    groups = available;
+    if (!groups.some((g) => g.id === selectedGroup) && !(inspectionSettingsLoaded && selectedGroup > 0)) {
+      const remembered = Number(stored(PREF_STORE + ".group"));
+      selectedGroup = groups.some((g) => g.id === remembered) ? remembered : groups[0]?.id || 0;
+      if (inspectionSettingsLoaded && selectedGroup) markInspectionEdit("group_id");
+    }
+    syncGroupControls();
+    if (!selectedGroup) { accountList = []; catalogCache.models = { ids: [] }; catalogLoaded = true; return; }
+    const group = selectedGroup;
+    const inGroup = () => current() && selectedGroup === group;
+    const accounts = await fetchNativeAccounts(group, signal, inGroup);
+    if (!inGroup()) return;
+    accountList = accounts.filter((account) => accountInGroup(account, group));
+    accountListReady = true;
+    accountListGroup = group;
+    const { ids, errors } = reuseModels && previousModelAccounts === enabledAccountIDs(accountList)
+      ? { ids: catalogCache.models.ids, errors: [] } : await discoverEvaluationModels(accountList, signal);
+    if (!inGroup()) return;
+    catalogCache.models = { ids };
+    fillModels();
+    if (errors.length) throw new Error(errors.join("；"));
+    catalogLoaded = true;
+    catalogGroup = group;
+  } catch (err) {
+    if (current() && !accountListReady) accountListError = err.message;
+    throw err;
+  }
+}
+
+const enabledAccountIDs = (accounts) => accounts.filter((account) => account.schedulable !== false).map((account) => String(account.id)).sort().join(",");
+const manualCatalogReady = () => !!selectedGroup && accountListReady && accountListGroup === selectedGroup;
+const catalogBlocker = () => manualCatalogReady() ? "" : accountListError ? "账户列表读取失败：" + accountListError : "正在读取账户列表，请稍候";
+const accountInGroup = (account, group = selectedGroup) => (account.group_ids || []).some((id) => Number(id) === group);
+async function fetchNativeAccounts(group, signal, current = () => !signal?.aborted) {
+  const accounts = [];
+  const filter = group == null ? "" : `&group=${group}`;
+  for (let page = 1; ; page++) {
+    const data = await api(`/api/v1/admin/accounts?platform=openai${filter}&lite=1&page=${page}&page_size=100`, { signal });
+    if (!current()) return [];
+    accounts.push(...data.items);
+    if (page >= data.pages || !data.items.length) return accounts;
+  }
+}
+
+async function discoverEvaluationModels(accounts, signal) {
+  const enabled = accounts.filter((account) => account.schedulable !== false);
+  const results = await Promise.allSettled(enabled.map((account) => api(`/api/v1/admin/accounts/${account.id}/codex-eval/models`, { signal })));
+  if (signal?.aborted) return { ids: [], errors: [] };
+  const ids = [], errors = [];
+  results.forEach((result, i) => {
+    if (result.status === "fulfilled") ids.push(...result.value.map((model) => model.id));
+    else {
+      if (result.reason instanceof AuthError) throw result.reason;
+      errors.push(`${enabled[i].name}：${result.reason.message}`);
+    }
+  });
+  return { ids: [...new Set(ids)].filter((id) => !HIDDEN_MODEL(id)).sort(compareModels), errors };
+}
