+++ b/backend/internal/codexeval/web/style.css
@@ -0,0 +1,453 @@
+/* Layout */
+:root {
+  /* Content stays within CPAMP's 1280px .container width so wide screens don't spread the list apart. */
+  --page-width: 1280px;
+  --list-padding: 22px; --list-gap: 16px; --list-checkbox: 22px; --credential-indent: 20px; --switch-width: 32px; --action-width: 88px;
+  --credential-track: minmax(0, 300px); --result-track: minmax(0, 280px); --marks-width: 208px;
+}
+
+/* Base */
+/* CPAMP injects zero-specificity base styles into the pages it embeds. Revert them below <html> so this sheet
+   alone styles the page; SVG icons are left out to keep their presentation attributes. */
+:where(body, body :not(svg, svg *)) { all: revert; }
+* { box-sizing: border-box; }
+html { background: var(--bg-image) fixed var(--bg); }
+body {
+  margin: 0; padding: 0 var(--page-inline); color: var(--ink);
+  font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+.mono, .markdown code { font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
+main { display: flow-root; min-height: 100dvh; max-width: var(--page-width); margin: 0 auto; padding-top: var(--page-top); }
+.page-footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 0; padding: 24px 12px max(32px, env(safe-area-inset-bottom)); color: var(--faint); font-size: 11px; }
+.page-footer span { white-space: nowrap; }
+.page-footer a { color: inherit; text-decoration: none; }
+.page-footer a:hover, .page-footer a:focus-visible { color: var(--muted); }
+button, input, select { font: inherit; color: inherit; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.icon { display: block; width: 16px; height: 16px; flex: none; }
+.spin { animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+[hidden] { display: none !important; }
+
+/* Shared controls */
+.card { background: var(--surface); border: 1px solid var(--card-line); border-radius: var(--radius); box-shadow: var(--shadow); backdrop-filter: var(--glass); overflow: clip; }
+.inspection-settings { display: grid; gap: 24px; max-width: 1152px; margin: 0 auto; }
+.settings-card-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 24px; border-bottom: 1px solid var(--line); }
+.settings-card-header h2 { margin: 0; font-size: 18px; font-weight: 600; }
+.settings-card .switch { font-size: 14px; }
+.settings-card-header .switch { gap: 12px; min-height: 28px; }
+.settings-card-body { display: grid; gap: 20px; padding: 24px; }
