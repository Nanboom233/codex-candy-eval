+.answer-content { overflow: hidden; overflow-wrap: anywhere; }
+.answer-content.error { color: var(--danger-ink); white-space: pre-wrap; }
+/* Expanded answers are as wide as their longest line, so display formulas center on the text. */
+.answer.expanded .markdown { justify-self: start; }
+/* Collapsed answers and result tips flatten into running text. Each formula sits in a line-tall box with
+   the text's strut, so short formulas share the baseline and tall ones, such as cases, are clipped instead
+   of stretching the line. Temml writes display formulas' display inline, hence !important. */
+.answer:not(.expanded) .answer-content { text-overflow: ellipsis; white-space: nowrap; }
+:is(.answer:not(.expanded) .markdown, .tip-text) :not(code, eq, eqn, math, math *) { display: inline; margin: 0; padding: 0; border: 0; background: none; font-size: inherit; white-space: inherit; }
+:is(.answer:not(.expanded) .markdown, .tip-text) br { display: none; }
+:is(.answer:not(.expanded) .markdown, .tip-text) :is(eq, eqn) { display: inline-block; height: 1lh; vertical-align: top; overflow: clip; }
+:is(.answer:not(.expanded) .markdown, .tip-text) math { display: inline !important; display: math !important; }
+.markdown :is(p, ul, ol, pre, table, blockquote, section) { margin: 0 0 8px; }
+.markdown :is(h1, h2, h3, h4, h5, h6) { margin: 12px 0 6px; font-size: 1em; font-weight: 600; }
+.markdown > :first-child { margin-top: 0; }
+.markdown > :last-child { margin-bottom: 0; }
+.markdown :is(ul, ol) { padding-left: 20px; }
+.markdown code { padding: 1px 4px; border-radius: 4px; background: var(--sunken); font-size: .92em; }
+.markdown pre code { padding: 0; background: none; font-size: inherit; }
+.markdown table { display: block; width: fit-content; max-width: 100%; border-collapse: collapse; }
+.markdown blockquote { padding-left: 10px; border-left: 3px solid var(--line); color: var(--muted); }
+.markdown hr { margin: 10px 0; border: 0; border-top: 1px solid var(--line); }
+/* texmath wraps display formulas in <section><eqn>. */
+.markdown eqn { display: block; }
+
+/* Collection results and history */
+.collection-progress { width: 100%; height: 8px; margin-top: 7px; accent-color: var(--accent); }
+.outcome { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.outcome-icon {
+  --size: var(--outcome-size, 38px); display: inline-flex; align-items: center; justify-content: center; width: var(--size); height: var(--size); flex: none;
+  border: 1px solid color-mix(in srgb, var(--status-ink, var(--muted)) 16%, var(--status-bg, var(--control-bg))); border-radius: calc(var(--size) * .3); background: var(--status-bg, var(--control-bg)); color: var(--status-ink, var(--muted));
+}
+.outcome-icon .icon { width: calc(var(--size) * .55); height: calc(var(--size) * .55); }
+.outcome.idle { --status-ink: var(--faint); }
+.outcome.idle .outcome-title { color: var(--muted); font-weight: 500; }
+.outcome-copy { min-width: 0; flex: 1; }
+.outcome-title { font-weight: 600; line-height: 1.5; }
+.outcome-detail { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 6px; color: var(--muted); font-size: 12px; margin-top: 3px; overflow-wrap: anywhere; }
+.outcome-detail .icon { width: 12px; height: 12px; }
+.outcome-detail strong { color: var(--ink); font-weight: 500; }
+.test-time { color: var(--muted); font-size: 12px; white-space: nowrap; }
+.history-title { padding: 0 0 8px; color: var(--muted); font-size: 12px; }
+.result-history { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 8px; }
+.result-history > .none { grid-column: 1 / -1; padding: 4px 0; text-align: center; }
+.history-card { --outcome-size: 30px; min-width: 0; background: var(--history-bg); border: 1px solid var(--control-line); border-radius: 10px; overflow: clip; }
+.record-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; color: var(--muted); font-size: 12px; }
+.history-card-head { padding: 8px 12px; background: var(--history-head-bg); border-bottom: 1px solid var(--control-line); }
+.history-card-body { display: flex; align-items: center; gap: 12px; padding: 10px 12px; font-size: 13px; }
+.history-card-body > .btn { flex: none; }
+.history-card .outcome { flex: 1; }
+.history-card .outcome-title { font-size: 13px; }
+
+/* Pelican previews */
+/* A preview lays a page out in an 800×600 viewport and scales it by --preview-scale. */
+.preview {
+  position: relative; display: grid; place-items: center; flex: none; width: calc(800px * var(--preview-scale)); aspect-ratio: 4 / 3; overflow: hidden;
+  border: 1px solid var(--control-line); border-radius: 8px; background: var(--sunken); color: var(--faint);
+}
+.preview iframe { position: absolute; top: 0; left: 0; width: 800px; height: 600px; border: 0; background: #fff; scale: var(--preview-scale); transform-origin: 0 0; }
+.preview-open { position: absolute; inset: 0; padding: 0; border: 0; border-radius: inherit; background: none; cursor: zoom-in; }
+.preview-open:hover, .preview-open:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+.preview[data-tip] { cursor: help; }
+.history-card .preview { --preview-scale: .3; }
+/* The dialog stage fits on screen; fitPelicanStage scales its page to match. */
+.pelican-stage { width: min(100%, max(280px, calc((100dvh - 310px) * 4 / 3))); margin: 0 auto; }
+
+/* Dialogs */
+dialog { border: 1px solid var(--line); border-radius: 14px; background: var(--dialog-bg); color: var(--ink); box-shadow: var(--float); backdrop-filter: var(--glass); }
+dialog::backdrop { background: rgb(0 0 0 / 35%); }
+.confirm { width: min(400px, calc(100vw - 32px)); padding: 22px; }
+.confirm h2 { margin: 0 0 6px; font-size: 16px; }
+.confirm p { margin: 0 0 20px; color: var(--muted); font-size: 13px; }
+.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
+.dialog-actions .btn { height: 34px; }
+/* Centered dialogs leave 80px above the header for CPA's floating controls. */
+.result-dialog { --dialog-padding: 22px; width: min(920px, calc(100vw - 32px)); max-height: calc(100dvh - 160px); padding: 0; border-radius: 16px; }
+.result-dialog-head { --heading-padding: 18px var(--dialog-padding); --heading-size: 18px; position: sticky; top: 0; z-index: 1; background: var(--dialog-bg); backdrop-filter: var(--glass); }
+.result-dialog-body { padding: var(--dialog-padding); }
+.result-dialog-meta { margin: 0 0 18px; color: var(--muted); font-size: 12px; }
+.result-dialog-section { margin-top: 24px; }
+.result-dialog-section h3 { font-size: 14px; margin: 0 0 10px; }
+.detail-note { color: var(--muted); font-size: 12px; margin: 10px 0 0; line-height: 1.7; }
+.detail-warning { color: var(--danger-ink); overflow-wrap: anywhere; }
+
+/* Fingerprint details */
+.fp-detail-table { width: 100%; border-collapse: collapse; white-space: nowrap; font-size: 12px; }
+.fp-test-model { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
+.fp-prediction { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; overflow-wrap: anywhere; font-size: 13px; }
+.fp-sample { border-top: 1px solid var(--line); padding: 12px 0; }
+.fp-sample summary { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; cursor: pointer; font-size: 13px; }
+.fp-sample summary .chev { color: var(--muted); }
+.fp-sample[open] summary .chev { transform: rotate(90deg); }
+.fp-sample pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 260px; }
+.fp-sample h4 { font-size: 14px; font-weight: 500; }
+
+/* Feedback and login */
+.legend { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; color: var(--muted); font-size: 12px; line-height: 20px; margin: 0 4px 10px; }
+.legend span { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
+.legend #rate-scope { margin-left: auto; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
+.empty { padding: 40px 20px; text-align: center; color: var(--muted); }
+.login { max-width: 380px; margin: 12vh auto 0; padding: 24px; }
+.login h2 { margin: 0 0 6px; font-size: 17px; }
+.login p { margin: 0 0 16px; color: var(--muted); font-size: 13px; }
+.login form { display: flex; gap: 8px; }
+.login input { flex: 1; }
+.login .error { margin: 10px 0 0; color: var(--danger-ink); }
+.global-flash { display: flex; align-items: flex-start; gap: 10px; margin: 0 0 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--sunken); color: var(--muted); }
+.global-flash[data-tone="error"] { background: var(--danger-soft); color: var(--danger-ink); border-color: color-mix(in srgb, var(--danger) 25%, var(--line)); }
+.global-flash[data-tone="warning"] { background: var(--warning-soft); color: var(--warning-ink); }
+.notice-symbol { display: inline-flex; flex: none; margin-top: 3px; }
+.notice-message { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+.notice-close { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 24px; height: 24px; padding: 3px; border: 0; border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
+.notice-close:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
+
+/* Responsive layout */
+@media (hover: none) { .copy-btn { opacity: 1; } }
+@media (max-width: 1100px) {
+  :root { --marks-width: 104px; }
+}
+@media (max-width: 1000px) {
+  :root { --list-padding: 18px; --list-gap: 10px; }
+  .result-history { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 900px) {
+  #pl-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  #pl-toolbar > .btn { min-width: 0; width: 100%; }
+}
+@media (max-width: 768px) {
+  :root { --list-padding: 16px; }
+  .page-navigation .tab { padding: 0 12px; }
+  .list-head { display: none; }
+  .list-row {
+    --outcome-size: 30px; grid-template-columns: var(--list-checkbox) minmax(0, 1fr) auto; row-gap: 14px; padding-block: 16px;
+    grid-template-areas: "select credential action" ". latest latest" ". meta meta";
+  }
+  .list-row > .select-cell { grid-area: select; }
+  .list-row > .credential { grid-area: credential; }
+  .list-row > .latest { grid-area: latest; padding-left: var(--credential-indent); }
+  .list-row > .btn { grid-area: action; }
+  .row-meta { grid-area: meta; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; min-width: 0; padding-left: var(--credential-indent); }
+  .row-meta.untested > :not(.switch):not(.inspection-cell) { display: none; }
+  .row-meta > .switch { align-self: flex-end; margin-left: auto; }
+  #candy-panel .row-meta > :is(.switch, .inspection-cell) { align-self: flex-start; }
+  .row-meta > .switch::before { content: "启用"; }
+  .inspection-cell .switch::before { content: "启用自动巡检"; }
+  .row-meta > .marks { flex: 1; }
+  .credential-head { flex-wrap: wrap; row-gap: 10px; }
+  .credential-enabled-filter { margin-right: auto; }
+  .candy-head .inspection-status { order: 1; flex-basis: 100%; }
+  .credential-filters { order: 1; flex-basis: 100%; }
+  .credential-filter { flex: 1 1 0; }
+  .rate { display: flex; flex-basis: 100%; align-items: baseline; gap: 5px; white-space: nowrap; }
+  .rate::before { content: "正确率"; color: var(--muted); font-size: 12px; }
+  .rate b { font-size: 14px; } .rate small { display: inline; }
+
+  .toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .toolbar > .btn { min-width: 0; width: 100%; }
+  .history-panel { grid-template-columns: var(--list-checkbox) minmax(0, 1fr); padding-block: 0 16px; }
+  .record-meta { gap: 4px 12px; }
+  .record-meta > :is(.result-meta, .metrics) { display: contents; }
+  .history-card-body { flex-wrap: wrap; }
+  .history-card-body > .btn { margin-left: auto; }
+  .history-card .outcome { flex-basis: 100%; }
+  .answer { grid-template-columns: auto minmax(0, 1fr); }
+  .answer-toggle { justify-self: end; }
+  .answer-content { grid-column: 1 / -1; }
+  .result-dialog { --dialog-padding: 16px; }
+  #fp-toolbar > .btn { grid-column: 1 / -1; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .spin, #refresh[aria-busy="true"] .icon { animation: none; }
+  .page-navigation button, .mark-hit, .copy-btn, .chev, .credential .name, .switch > input, .switch > input::before { transition: none; }
+}
diff --git a/backend/internal/codexeval/web/theme.css b/backend/internal/codexeval/web/theme.css
new file mode 100644
index 0000000..b1851c0
--- /dev/null
+++ b/backend/internal/codexeval/web/theme.css
@@ -0,0 +1,52 @@
+/* Tokens
+   Components read only these tokens. The panel embedding the page supplies most of them below; data-theme
+   mirrors that panel's theme. */
+:root {
+  --premium-ink: #6b4b00; --premium-line: rgb(217 165 22 / 72%); --premium-glow: 0 1px 3px rgb(133 92 0 / 16%), 0 0 10px rgb(255 214 98 / 28%);
+  --premium-soft: radial-gradient(circle at 18% 24%, rgb(255 255 255 / 96%), rgb(255 255 255 / 0) 42%), linear-gradient(135deg, #fff9e3, #ffe07f 52%, #e0aa14);
+  --plus-ink: #2463b0; --plus-soft: #eaf2fd; --plus-line: #c8dcf6; --go-ink: #0e7773; --go-soft: #e3f5f3; --go-line: #bfe5e0;
+  --business-ink: #6b46c1; --business-soft: #f2edfc; --business-line: #dcd0f5;
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --premium-ink: #fff0a8; --premium-line: rgb(226 180 50 / 70%); --premium-glow: 0 1px 6px rgb(0 0 0 / 28%), 0 0 12px rgb(255 196 44 / 22%);
+  --premium-soft: radial-gradient(circle at 18% 24%, rgb(255 229 138 / 32%), rgb(255 214 98 / 0) 44%), linear-gradient(135deg, #4f3d0b, #6e5510 48%, #8f6d10);
+  --plus-ink: #93c1f7; --plus-soft: #16283d; --plus-line: #2a4868; --go-ink: #7fd6cf; --go-soft: #112f2d; --go-line: #245450;
+  --business-ink: #c4b0f5; --business-soft: #251e3a; --business-line: #45386b;
+  color-scheme: dark;
+}
+
+/* Native Sub2API light/dark colors; original component layout and plan badges. */
+:root {
+  --page-top: 24px; --page-inline: clamp(20px, 3vw, 48px); --section-gap: 24px;
+  --bg: #f9fafb; --bg-image: none; --surface: #fff; --sunken: #f3f4f6; --field: #fff;
+  --line: #e5e7eb; --card-line: var(--line); --ink: #111827; --muted: #6b7280; --faint: #9ca3af;
+  --control-bg: var(--surface); --control-line: #d1d5db; --control-hover: var(--sunken); --control-hover-line: #9ca3af;
+  --history-bg: var(--bg); --history-head-bg: var(--sunken);
+  --tag-neutral-bg: var(--sunken); --tag-neutral-ink: var(--muted); --tag-neutral-line: var(--line);
+  --accent: #14b8a6; --accent-ink: #0d9488; --accent-soft: rgb(20 184 166 / 10%);
+  --accent-soft-hover: rgb(20 184 166 / 16%); --action-line: rgb(20 184 166 / 30%);
+  --success: #10b981; --success-ink: #065f46; --success-soft: #d1fae5;
+  --danger: #ef4444; --danger-ink: #b91c1c; --danger-soft: rgb(239 68 68 / 10%);
+  --danger-soft-hover: rgb(239 68 68 / 18%); --danger-line: rgb(239 68 68 / 30%);
+  --warning-ink: #92400e; --warning-soft: rgb(245 158 11 / 10%); --warning-line: rgb(245 158 11 / 30%);
+  --radius: 12px; --shadow: 0 1px 3px rgb(0 0 0 / 4%), 0 1px 2px rgb(0 0 0 / 6%);
+  --float: 0 12px 26px rgb(0 0 0 / 14%); --glass: none;
+  --tip-bg: #111827; --tip-ink: #f9fafb; --tip-line: transparent;
+  --tip-shadow: var(--float); --tip-radius: 10px; --tip-padding: 9px 12px;
+  --popover-bg: var(--surface); --popover-line: var(--line); --popover-shadow: var(--float); --dialog-bg: var(--surface);
+}
+:root[data-theme="dark"] {
+  --bg: #0f172a; --surface: #1e293b; --sunken: #334155; --field: #0f172a;
+  --line: #334155; --ink: #f1f5f9; --muted: #94a3b8; --faint: #64748b;
+  --control-line: #475569; --control-hover-line: #64748b;
+  --accent: #2dd4bf; --accent-ink: #5eead4;
+  --success-ink: #6ee7b7; --success-soft: rgb(6 78 59 / 30%);
+  --danger-ink: #fca5a5; --danger-soft: rgb(239 68 68 / 20%); --danger-soft-hover: rgb(239 68 68 / 30%);
+  --warning-ink: #fcd34d; --warning-soft: rgb(245 158 11 / 14%);
+  --shadow: 0 1px 3px rgb(0 0 0 / 30%); --float: 0 14px 30px rgb(0 0 0 / 40%);
+  --tip-bg: #334155; --tip-ink: #f1f5f9; --tip-line: #475569;
+}
+@media (max-width: 768px) {
+  :root { --page-inline: 16px; }
+}
diff --git a/backend/internal/codexeval/web/ui.html b/backend/internal/codexeval/web/ui.html
