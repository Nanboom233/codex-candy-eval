+}
+function switchTab(name) {
+  for (const tab of tabNames) {
+    const active = name === tab;
+    $("tab-" + tab).setAttribute("aria-selected", active);
+    $("tab-" + tab).tabIndex = active ? 0 : -1;
+    $(tab + "-panel").hidden = !active;
