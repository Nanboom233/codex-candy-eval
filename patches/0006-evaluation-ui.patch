+    if (runID) return run({ targets: targetsFor([runID]) });
+    const cancelID = action("cancel");
+    if (cancelID) return update("/cancel", { method: "POST", body: { run_id: credentials.find((a) => a.id === cancelID)?.task?.id } }, "停止测试失败");
