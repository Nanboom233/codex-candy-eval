+.list-actions { display: flex; gap: 8px; }
+
+/* Candy results */
+.tip .metrics { margin-top: 6px; }
+.tip-text { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
