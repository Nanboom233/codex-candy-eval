+let inspectionTimer = 0;
+let inspectionAutosaveTimer = 0;
+let inspectionSavePromise = null;
+let inspectionFormRevision = 0;
+let inspectionSettingsGeneration = 0;
+const inspectionDirtyFields = new Map();
+let inspectionState = { results: [] };
+let inspectionStateController = null;
+
+function inspectionForm() { return document.getElementById("inspection-settings"); }
+function inspectionField(name) { return CANDY_SELECTION_FIELDS[name] ? $(CANDY_SELECTION_FIELDS[name]) : inspectionForm().elements.namedItem(name); }
+function inspectionMessage(message, error = false) {
+  for (const id of ["inspection-save-status"]) {
+    $(id).textContent = message;
+    $(id).classList.toggle("error", error);
