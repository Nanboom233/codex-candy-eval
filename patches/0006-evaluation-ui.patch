+<!doctype html>
+<html lang="zh-CN">
+<!--FINGERPRINT_LICENSE-->
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Codex 降智测试</title>
+  <style>/*APP_STYLES*/</style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1><i data-icon="candy"></i>Codex 降智测试</h1>
+    </header>
+
+    <section id="login" class="card login" hidden><p id="login-error" class="error" hidden></p></section>
+
+    <div id="app" hidden>
+      <div class="page-navigation card">
+        <div class="tabs" role="tablist" aria-label="测试类型">
+          <button id="tab-candy" class="tab" role="tab" aria-selected="true" aria-controls="candy-panel" type="button">糖果</button>
+          <button id="tab-fingerprint" class="tab" role="tab" aria-selected="false" aria-controls="fingerprint-panel" tabindex="-1" type="button">指纹</button>
+          <button id="tab-pelican" class="tab" role="tab" aria-selected="false" aria-controls="pelican-panel" tabindex="-1" type="button">鹈鹕</button>
+          <button id="tab-settings" class="tab" role="tab" aria-selected="false" aria-controls="settings-panel" tabindex="-1" type="button">设置</button>
+        </div>
+        <div class="page-actions">
+          <button id="clear-all" type="button" aria-label="清空全部测试记录" data-tip disabled><i data-icon="trash-2"></i></button>
+          <button id="refresh" type="button" aria-label="刷新账户和模型" data-tip aria-busy="false"><i data-icon="rotate-cw"></i></button>
+        </div>
+      </div>
+      <div id="notifications"></div>
+      <section id="candy-panel" role="tabpanel" aria-labelledby="tab-candy">
+        <div class="panel-intro">
+          <p>让模型解一道糖果题，答出 <b class="mono">21</b> 即为正确。</p>
+          <details class="problem">
+            <summary><i data-icon="chevron-right" data-class="chev"></i>查看题目</summary>
+            <div class="problem-body"><pre class="mono"><code><!--CANDY_PROMPT--></code></pre>
+              <button class="copy-btn" type="button" aria-label="复制题目" data-tip></button>
+            </div>
+          </details>
+        </div>
+        <form id="toolbar" class="card toolbar">
+          <label class="field"><span class="field-label">分组</span><span class="native-select"><select id="group" data-group-select></select></span></label>
+          <div class="field"><label class="field-label" for="model-select">模型</label><span class="native-select"><select id="model-select"></select></span><input id="model" maxlength="200" required aria-label="自定义模型" hidden></div>
+          <label class="field"><span class="field-label">推理强度</span><span class="native-select"><select id="effort"></select></span></label>
+          <label class="field"><span class="field-label">每账户次数</span><input id="runs" class="mono" type="number" min="1" max="10" step="1" value="1" required></label>
+          <button id="run-batch" class="btn" type="submit" disabled>测试全部</button>
+        </form>
+
+        <div class="legend">
+          <span><i data-icon="circle-check" data-class="mark ok"></i>答对</span>
+          <span><i data-icon="circle-x" data-class="mark bad"></i>答错</span>
+          <span><i data-icon="circle-alert" data-class="mark err"></i>请求出错</span>
+          <span><i data-icon="ban" data-class="mark err"></i>已跳过</span>
+          <span><i data-icon="circle-check" data-class="mark ok dim"></i>其他模型或推理强度</span>
+          <span id="rate-scope"></span>
+        </div>
+
+        <section id="candy-credentials" class="card"></section>
+      </section>
+      <section id="fingerprint-panel" role="tabpanel" aria-labelledby="tab-fingerprint" hidden>
+        <form id="fp-toolbar" class="card toolbar">
+          <label class="field"><span class="field-label">分组</span><span class="native-select"><select id="fp-group" data-group-select></select></span></label>
+          <div class="field"><label class="field-label" for="fp-model-select">模型</label><span class="native-select"><select id="fp-model-select"></select></span><input id="fp-model" maxlength="200" required aria-label="自定义模型" hidden></div>
+          <label class="field"><span class="field-label">每账户并发</span><input id="fp-concurrency" class="mono" type="number" min="1" step="1" required></label>
+          <button id="fp-run-batch" class="btn" type="submit" disabled>测试全部</button>
+        </form>
+        <section id="fp-credentials" class="card"></section>
+      </section>
+      <section id="pelican-panel" role="tabpanel" aria-labelledby="tab-pelican" hidden>
+        <div class="panel-intro">
+          <p>让模型用 SVG 绘制鹈鹕画面，可选择原版动画或多合一场景。</p>
+          <details class="problem">
+            <summary><i data-icon="chevron-right" data-class="chev"></i>查看题目</summary>
+            <div class="problem-body"><pre class="mono"><code id="pl-prompt"></code></pre>
+              <button class="copy-btn" type="button" aria-label="复制题目" data-tip></button>
+            </div>
+          </details>
