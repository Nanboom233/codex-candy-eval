{
  "description": "Devin project hooks: resolve Trellis session context per Devin session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Nanboom233/.devin/trellis-session/hooks/trellis_session_bridge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Nanboom233/.devin/trellis-session/hooks/trellis_session_bridge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompaction": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Nanboom233/.devin/trellis-session/hooks/trellis_session_bridge.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
